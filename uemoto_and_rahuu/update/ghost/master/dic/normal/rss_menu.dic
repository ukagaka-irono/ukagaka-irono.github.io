//******************************************************************************
// 植本とラフウ
// RSS購読メニュー辞書
//
// 項目数が多い（都道府県47・施設348）ので、地方→都道府県→施設 と辿らせる。
//
// ■動的メニューの作り方
//   ＠メニュー：… というEX記法は固定の行しか書けないので、
//   件数が変わるものは あやりりす の メニュー() / 半分メニュー() を
//   直接呼んで文字列を組み立てる。
//   このとき foreach の中で候補として出すと「どれか1つ」が選ばれてしまうので、
//   必ず変数に += で足しこんで、最後に1つの文字列として返すこと。
//******************************************************************************

//==============================================================================
// 地方の区分（都道府県コードでまとめる）
//==============================================================================
RSS地方一覧 : array
{
	'1|北海道'
	'2|東北'
	'3|関東'
	'4|中部'
	'5|近畿'
	'6|中国'
	'7|四国'
	'8|九州・沖縄'
}

RSS地方コード
{
	_c = TOINT(_argv[0])

	if _c <= 1  { 1;  return }
	if _c <= 7  { 2;  return }
	if _c <= 14 { 3;  return }
	if _c <= 23 { 4;  return }
	if _c <= 30 { 5;  return }
	if _c <= 35 { 6;  return }
	if _c <= 39 { 7;  return }
	8
}

//---- メニューの見出し（植物段階を反映したサーフィス指定つき）
RSSメニュー見出し
{
	"\0\s[%(植物段階)]" + _argv[0] + '\_q\n\n'
}


//==============================================================================
// 各種設定変更
//==============================================================================
Menu_CONFIG
{
	<<"
	植：どれを変える？
	＠半分メニュー：名前を教える｜Menu_TELLNAME
	＠半分メニュー：喋る頻度変えて｜Menu_INTERVAL
	＠半分メニュー：RSSフィードについて｜Menu_RSS_ABOUT
	＠半分メニュー：RSSフィード｜Menu_RSS
	＠改行多めメニュー：戻る｜OpenMenu
	">>
}


//==============================================================================
// RSSフィードについて
//==============================================================================
Menu_RSS_ABOUT
{
	_num = ARRAYSIZE(RSS購読リスト)
	_int = TOINT(RSS取得間隔分)

	_s  = RSSメニュー見出し('植物園のお知らせを、時々読み上げてる。')
	_s += 'いま購読しているのは ' + _num + ' 件。\n'
	_s += _int + '分おきに、そのうち1つずつ見に行ってる。\n'

	//---- 全部を一巡するのにかかる時間。購読を増やすほど1件あたりは遅くなる。
	if _num >= 2 {
		_s += '全部を一周するのに、だいたい ' + ((_num * _int) / 60) + '時間 ' + ((_num * _int) % 60) + '分。\n'
	}

	//---- 防災は優先して見に行くので、周期を分けて出す
	_pri = RSS優先件数
	if _pri > 0 {
		_s += '防災は優先で、だいたい ' + ((_pri * 4) / 3) + '分に一周してる。\n'
		if ((_pri * 4) / 3) > 10 {
			_s += '\_q※気象庁は直近10分しか載らないから、これだと取りこぼすよ。\n'
			_s += '　防災の購読を減らしたほうがいい。\n'
		}
	}

	_s += '\n情報源は「EVERGREEN 植物園リスト」（全国・都道府県別・施設別）、\n'
	_s += '京都府立大学の植物学研究室、\n'
	_s += '気象庁・消防庁・防災科研、NHK、Yahoo!ニュース。\n'
	_s += '新しいお知らせが出ていた時だけ喋るよ。\n'
	_s += 'タイトルを押すと、その記事を開けるからね。\n\n'
	_s += '\_q※これは防災の手段じゃないよ。\n'
	_s += '　見に行く間隔のぶんだけ必ず遅れるから、\n'
	_s += '　急ぐ時は本物の警報を見てね。\n\n'
	_s += メニュー('購読を選ぶ', 'Menu_RSS') + '\n'
	_s += メニュー('戻る', 'Menu_CONFIG')
	_s += '\e'

	_s
}


//==============================================================================
// RSSフィード（購読の選択）
//==============================================================================
Menu_RSS
{
	_s  = RSSメニュー見出し('どのお知らせを聞く？　■が購読中。')

	_s += 半分メニュー開始
	_s += 半分メニュー(RSS印(RSS全国フィード) + '全国まとめ', 'Menu_RSS_TOGGLE', RSS全国フィード)
	foreach RSS外部フィード ; _e {
		_s += 半分メニュー(RSS印(_e[2,'|']) + _e[1,'|'], 'Menu_RSS_TOGGLE', _e[2,'|'])
	}
	_s += 半分メニュー終了
	_s += '\n'

	_s += メニュー('都道府県別から選ぶ', 'Menu_RSS_PREF_REGION') + '\n'
	_s += メニュー('施設別から選ぶ', 'Menu_RSS_FAC_REGION') + '\n\n'
	_s += メニュー('防災（気象庁・消防庁・J-RISQ）', 'Menu_RSS_BOSAI') + '\n'
	_s += メニュー('ニュース（NHK・Yahoo!）', 'Menu_RSS_NEWS') + '\n'
	_s += メニュー('提供メディアから選ぶ', 'Menu_RSS_MEDIA') + '\n\n'
	_s += メニュー('購読中の一覧を見る', 'Menu_RSS_LIST') + '\n'
	_s += メニュー('今すぐ確認する', 'Menu_RSS_NOW') + '\n'
	_s += メニュー('全部やめる', 'Menu_RSS_CLEAR') + '\n\n'
	_s += メニュー('戻る', 'Menu_CONFIG')
	_s += '\e'

	_s
}

//------------------------------------------------------------------------------
// 購読の切り替え
//   選択肢引数取得(0) … 対象のURL
//   選択肢引数取得(1) … 切り替えた後に戻る先のメニュー関数名（省略可）
//------------------------------------------------------------------------------
Menu_RSS_TOGGLE
{
	RSS購読切替(選択肢引数取得(0))

	_back = 選択肢引数取得(1)
	if !STRLEN(_back) {
		_back = 'Menu_RSS'
	}

	//---- 戻り先が引数を拾ってしまわないよう、ここで消しておく
	選択肢引数 = IARRAY

	//---- 切り替えたら同じ画面に戻す（続けて選べるように）
	EVAL(_back)
}


//==============================================================================
// 防災・ニュース・提供メディア
//==============================================================================

//---- 1ページに並べる提供メディアの件数
RSSメディア1ページ件数
{
	20
}

Menu_RSS_BOSAI
{
	_s  = RSSメニュー見出し('防災の情報。　■が購読中。')
	_s += '気象庁のフィードは直近10分ぶんしか載らないから、\n'
	_s += '選びすぎると取りこぼすよ。\_q\n\n'

	_s += 半分メニュー開始
	foreach RSS防災カタログ ; _e {
		_s += 半分メニュー(RSS印(_e[2,'|']) + _e[1,'|'], 'Menu_RSS_TOGGLE', _e[2,'|'], 'Menu_RSS_BOSAI')
	}
	_s += 半分メニュー終了
	_s += '\n'
	_s += メニュー('戻る', 'Menu_RSS')
	_s += '\e'

	_s
}

Menu_RSS_NEWS
{
	_s = RSSメニュー見出し('ニュース。　■が購読中。')

	_s += 半分メニュー開始
	foreach RSS報道カタログ ; _e {
		_s += 半分メニュー(RSS印(_e[2,'|']) + _e[1,'|'], 'Menu_RSS_TOGGLE', _e[2,'|'], 'Menu_RSS_NEWS')
	}
	_s += 半分メニュー終了
	_s += '\n'
	_s += メニュー('提供メディアから選ぶ', 'Menu_RSS_MEDIA') + '\n'
	_s += メニュー('戻る', 'Menu_RSS')
	_s += '\e'

	_s
}

//------------------------------------------------------------------------------
// 提供メディア（件数が多いのでページ送り）
//   選択肢引数取得(0) にページ番号。購読を切り替えて戻ってきた時は
//   引数が無いので、覚えておいたページを開き直す。
//------------------------------------------------------------------------------
Menu_RSS_MEDIA
{
	if STRLEN(選択肢引数取得(0)) {
		RSSメディアページ = TOINT(選択肢引数取得(0))
	}
	if !ISVAR('RSSメディアページ') {
		RSSメディアページ = 0
	}

	_all   = RSSメディアカタログ
	_n     = ARRAYSIZE(_all)
	_per   = TOINT(RSSメディア1ページ件数)
	_pages = (_n + _per - 1) / _per

	_p = TOINT(RSSメディアページ)
	if _p < 0 {
		_p = 0
	}
	if _p >= _pages {
		_p = _pages - 1
	}
	RSSメディアページ = _p

	_s = RSSメニュー見出し('提供メディア　' + (_p + 1) + ' / ' + _pages + 'ページ　■が購読中。')

	_end = (_p + 1) * _per
	if _end > _n {
		_end = _n
	}

	_s += 半分メニュー開始
	for _i = _p * _per; _i < _end; _i++ {
		_e = _all[_i]
		_s += 半分メニュー(RSS印(_e[2,'|']) + _e[1,'|'], 'Menu_RSS_TOGGLE', _e[2,'|'], 'Menu_RSS_MEDIA')
	}
	_s += 半分メニュー終了
	_s += '\n'

	if _p > 0 {
		_s += メニュー('◀ 前のページ', 'Menu_RSS_MEDIA', _p - 1) + '\n'
	}
	if _p < (_pages - 1) {
		_s += メニュー('次のページ ▶', 'Menu_RSS_MEDIA', _p + 1) + '\n'
	}
	if _p >= 10 {
		_s += メニュー('10ページ戻る', 'Menu_RSS_MEDIA', _p - 10) + '\n'
	}
	if _p < (_pages - 10) {
		_s += メニュー('10ページ進む', 'Menu_RSS_MEDIA', _p + 10) + '\n'
	}

	_s += '\n'
	_s += メニュー('戻る', 'Menu_RSS')
	_s += '\e'

	_s
}


//==============================================================================
// 都道府県別
//==============================================================================
Menu_RSS_PREF_REGION
{
	_s = RSSメニュー見出し('どのあたり？')

	_s += 半分メニュー開始
	foreach RSS地方一覧 ; _r {
		_s += 半分メニュー(_r[1,'|'], 'Menu_RSS_PREF', _r[0,'|'])
	}
	_s += 半分メニュー終了
	_s += '\n'
	_s += メニュー('戻る', 'Menu_RSS')
	_s += '\e'

	_s
}

Menu_RSS_PREF
{
	//---- 引数付きで呼ばれた時だけ選択を更新する。
	//     購読を切り替えた後にここへ戻ってくる時は引数が無いので、
	//     前回選んだ地方を覚えておいて使う。
	if STRLEN(選択肢引数取得(0)) {
		RSS地方選択 = 選択肢引数取得(0)
	}
	_region = RSS地方選択

	_s = RSSメニュー見出し('どの都道府県？　■が購読中。')

	_s += 半分メニュー開始
	foreach RSS都道府県カタログ ; _e {
		if RSS地方コード(_e[0,'|']) == TOINT(_region) {
			_s += 半分メニュー(RSS印(_e[2,'|']) + _e[1,'|'], 'Menu_RSS_TOGGLE', _e[2,'|'], 'Menu_RSS_PREF')
		}
	}
	_s += 半分メニュー終了
	_s += '\n'
	_s += メニュー('地方を選び直す', 'Menu_RSS_PREF_REGION') + '\n'
	_s += メニュー('戻る', 'Menu_RSS')
	_s += '\e'

	_s
}


//==============================================================================
// 施設別
//==============================================================================
Menu_RSS_FAC_REGION
{
	_s = RSSメニュー見出し('施設で選ぶ。まず、どのあたり？')

	_s += 半分メニュー開始
	foreach RSS地方一覧 ; _r {
		_s += 半分メニュー(_r[1,'|'], 'Menu_RSS_FAC_PREF', _r[0,'|'])
	}
	_s += 半分メニュー終了
	_s += '\n'
	_s += メニュー('戻る', 'Menu_RSS')
	_s += '\e'

	_s
}

Menu_RSS_FAC_PREF
{
	if STRLEN(選択肢引数取得(0)) {
		RSS地方選択 = 選択肢引数取得(0)
	}
	_region = RSS地方選択

	_s = RSSメニュー見出し('どの都道府県の施設？')

	_s += 半分メニュー開始
	foreach RSS都道府県カタログ ; _e {
		if RSS地方コード(_e[0,'|']) == TOINT(_region) {
			_s += 半分メニュー(_e[1,'|'], 'Menu_RSS_FAC', _e[0,'|'])
		}
	}
	_s += 半分メニュー終了
	_s += '\n'
	_s += メニュー('地方を選び直す', 'Menu_RSS_FAC_REGION') + '\n'
	_s += メニュー('戻る', 'Menu_RSS')
	_s += '\e'

	_s
}

Menu_RSS_FAC
{
	if STRLEN(選択肢引数取得(0)) {
		RSS都道府県選択 = 選択肢引数取得(0)
	}
	_pref = RSS都道府県選択

	_s = RSSメニュー見出し('どの施設？　■が購読中。')

	_n = 0
	foreach RSS施設カタログ ; _e {
		if SUBSTR(_e[0,'|'], 0, 2) == _pref {
			_s += メニュー(RSS印(_e[2,'|']) + _e[1,'|'], 'Menu_RSS_TOGGLE', _e[2,'|'], 'Menu_RSS_FAC') + '\n'
			_n++
		}
	}
	if _n == 0 {
		_s += 'この県の施設別フィードは無いみたい。\n'
	}

	_s += '\n'
	_s += メニュー('都道府県を選び直す', 'Menu_RSS_FAC_REGION') + '\n'
	_s += メニュー('戻る', 'Menu_RSS')
	_s += '\e'

	_s
}


//==============================================================================
// 購読中の一覧 / 全解除 / 今すぐ確認
//==============================================================================
Menu_RSS_LIST
{
	_list = RSS購読リスト
	_s = RSSメニュー見出し('いま購読しているのは、' + ARRAYSIZE(_list) + '件。')

	if ARRAYSIZE(_list) == 0 {
		_s += 'ひとつも選んでないよ。\n'
	}
	else {
		foreach _list ; _u {
			_s += '・' + RSS表示名(_u) + '\n'
		}
	}

	_s += '\n'
	_s += メニュー('戻る', 'Menu_RSS')
	_s += '\e'

	_s
}

Menu_RSS_CLEAR
{
	RSS購読 = IARRAY

	<<"
	植：ぜんぶやめた。
	ラ：静かになるな。
	植：また選んでくれてもいいよ。
	">>
}

Menu_RSS_NOW
{
	_list = RSS購読リスト
	if ARRAYSIZE(_list) == 0 {
		<<"
		植：まだ何も選んでないよ。
		ラ：先に選んでくれ。
		">>
		return
	}

	//---- 次の巡回を待たずに1件取りに行く
	RSS取得実行
}
