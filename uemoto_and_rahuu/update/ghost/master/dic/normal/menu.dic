//******************************************************************************
// 植本とラフウ
// メニュー辞書
//
// OpenMenu はあやりりす側からは呼ばれないので、
// 下の「3回連続クリック」「中クリック」「キー入力M」で自分から呼び出している。
//******************************************************************************

//==============================================================================
// 選択肢の「追加引数」を受け取るための処理
//
// ＠メニュー：表示｜関数名｜追加引数 と書くと \q[表示,関数名,追加引数] になるが、
// SSPが送ってくるイベントは2種類あり、中身が違う。
//
//   OnChoiceSelectEx : Reference0=表示 Reference1=関数名 Reference2以降=追加引数
//   OnChoiceSelect   : Reference0=関数名 のみ（追加引数は落ちる）
//
// あやりりすが見ているのは後者なので、追加引数はそのままでは受け取れない。
// そこで Ex の方を先に捕まえて、追加引数をグローバルへ移してから関数を呼ぶ。
//
// 追加引数が無い選択肢は何も返さずに素通りさせる。
// そうするとSSPが続けて OnChoiceSelect を送り、あやりりすが普段どおり処理する。
//==============================================================================
OnChoiceSelectEx
{
	//---- 追加引数が無いものは、あやりりすに任せる
	if !STRLEN(reference[2]) {
		return
	}

	_fn = reference[1]
	if !ISFUNC(_fn) {
		return
	}

	選択肢引数 = IARRAY
	_n = ARRAYSIZE(reference)
	for _i = 2; _i < _n; _i++ {
		選択肢引数 ,= reference[_i]
	}

	EVAL(_fn)
}

//------------------------------------------------------------------------------
// 追加引数の取り出し（無ければ空文字）
//------------------------------------------------------------------------------
選択肢引数取得
{
	if !ISVAR('選択肢引数') {
		''
		return
	}

	_i = TOINT(_argv[0])
	if _i >= ARRAYSIZE(選択肢引数) {
		''
		return
	}

	選択肢引数[_i]
}


//==============================================================================
// メニューを開くきっかけ
//==============================================================================

//------------------------------------------------------------------------------
// 3回連続クリック
//
// 「多重クリック」は3回目・4回目・5回目…と連続クリックのたびに呼ばれるので、
// クリック連続回数 で3回目ちょうどに限定する。
// 当たり判定名を付けていないので、体のどこを叩いても反応する。
//
// なお2回目の時点で通常のダブルクリック反応（talk_mouse.dic）が一度出る。
// SSPが1クリックごとに別イベントを送る仕様のため、これは避けられない。
//------------------------------------------------------------------------------
多重クリック0
{
	if クリック連続回数 == 3 {
		OpenMenu
	}
}

多重クリック1
{
	if クリック連続回数 == 3 {
		OpenMenu
	}
}

//------------------------------------------------------------------------------
// その他のきっかけ
//------------------------------------------------------------------------------
中クリック0
{
	OpenMenu
}

中クリック1
{
	OpenMenu
}

キー入力M
{
	OpenMenu
}


//==============================================================================
// メニュー本体
//==============================================================================
OpenMenu
{
	<<"
	植：なに？
	＠半分メニュー：何か話して｜Menu_AITALK
	＠半分メニュー：話しかける｜Menu_TALKTO
	＠半分メニュー：自己紹介して｜Menu_INTRO
	＠半分メニュー：お知らせ聞かせて｜Menu_RSS_PICK
	＠半分メニュー：お世話する｜Menu_CARE
	＠半分メニュー：植物の様子｜Menu_PLANT
	＠半分メニュー：よそに話しかける｜Menu_GHOSTTALK
	＠半分メニュー：各種設定変更｜Menu_CONFIG
	＠改行多めメニュー：なんでもない｜Menu_CANCEL
	">>
}

//------------------------------------------------------------------------------
Menu_AITALK
{
	"\![raise,OnAiTalk]"
}

//------------------------------------------------------------------------------
Menu_CANCEL
{
	<<"
	植：わかった。
	ラ：またなんかあったら呼べよ。
	">>
}

//------------------------------------------------------------------------------
// 自己紹介
// ===== で区切ると、前半を喋り終えてから後半が自動で続く（チェイン）。
//------------------------------------------------------------------------------
Menu_INTRO
{
	<<"
	植：自己紹介。
	ラ：あらたまるなあ。
	植：ウエモトです。植本と書いて、ウエモト。
	：頭に植物が生えてる。
	ラ：それが本体か？
	植：たぶん、どっちも本体。
	=====
	ラ：オレはラフウ。見てのとおり丸い。
	植：あったかいよ。
	ラ：まあ、そこは自信ある。
	=====
	植：頭の植物は、（ユーザー）と一緒にいる時間で育つ。
	：水をあげたり、日なたに出してもらえると、もう少し早く育つ。
	ラ：どっちも一日一回な。
	植：咲いたら、また芽から。
	：何回でも咲くから、気長に見てて。
	">>
}

//------------------------------------------------------------------------------
// お知らせ聞かせて
//
// 購読しているフィードそれぞれの最新記事を、まとめて読み上げる。
// 中身は rss.dic 側。タイトルを押すとその記事が開く。
//------------------------------------------------------------------------------
Menu_RSS_PICK
{
	_s = RSS話題をすべて

	if STRLEN(_s) {
		_s
		return
	}

	//---- 購読が空
	if ARRAYSIZE(RSS購読リスト) == 0 {
		<<"
		植：まだ何も購読してないよ。
		ラ：設定から選んでくれ。
		">>
		return
	}

	//---- 購読はしているが、まだ一度も取りに行けていない
	//     次の1分で取りに行くようにしておく
	RSS次回取得 = 1

	<<"
	植：まだ何も拾えてない。
	ラ：ちょっと見てくるから、少し待っててくれ。
	">>
}

//------------------------------------------------------------------------------
// 話しかける（入力ボックスを開く。反応は talk_communicate.dic）
//------------------------------------------------------------------------------
Menu_TALKTO
{
	"\![open,communicatebox]"
}

//------------------------------------------------------------------------------
// よそのゴーストに話しかける
// 起動中のゴーストからランダムに1体選んで話しかける（あやりりすの機能）。
// 誰もいない時は 話しかけられない が呼ばれる。
//------------------------------------------------------------------------------
Menu_GHOSTTALK
{
	他に話しかける
}

//------------------------------------------------------------------------------
// お世話する（水やり・日なた。どちらも1日1回。中身は plant.dic）
//------------------------------------------------------------------------------
Menu_CARE
{
	_w = ''
	if 水やり済みか {
		_w = '（今日はもうあげた）'
	}
	_s = ''
	if 日なた済みか {
		_s = '（今日はもう出した）'
	}

	<<"
	植：なにしてくれるの？
	＠メニュー：水をあげる%(_w)｜Menu_WATER
	＠メニュー：日なたに出す%(_s)｜Menu_SUN
	＠改行多めメニュー：やめておく｜Menu_CANCEL
	">>
}

Menu_WATER
{
	水をあげる
}

Menu_SUN
{
	日なたに出す
}

//------------------------------------------------------------------------------
// 植物の様子（plant.dic の状態を報告する）
// 最後に「アルバムを見る」（flower.dic）を選べるようにしている。
//------------------------------------------------------------------------------
Menu_PLANT
{
	植物の様子
	--
	C_CRLF + '＠メニュー：アルバムを見る｜Menu_ALBUM' + C_CRLF + '＠改行多めメニュー：とじる｜Menu_CANCEL'
}

植物の様子
{
	_zan = 植物次段階まで
	_lap = 植物周回数

	//---- 花が咲いている間（散るまでの残り時間を返す）
	if 植物段階 >= 6 {
		_name = 今咲いている花名
		if STRLEN(_name) {
			<<"
			植：今は、%(_name)が咲いてる。
			ラ：あと%(_zan)時間くらいで散るけどな。
			植：散っても、また咲くから。
			">>
			return
		}
		<<"
		植：今は、花。
		ラ：あと%(_zan)時間くらいで散るけどな。
		植：散っても、また咲くから。
		">>
		return
	}

	//---- まだ一度も咲いていない
	if _lap <= 0 {
		if _zan <= 1 {
			<<"
			植：今は%(植物段階名)。
			：もうすぐ、なにか変わりそう。
			ラ：楽しみだな。
			">>
			return
		}

		<<"
		植：今は%(植物段階名)。
		ラ：次まではどれくらいなんだ？
		植：あと%(_zan)時間くらい、一緒にいてくれたら。
		">>
		return
	}

	//---- 2周目以降
	<<"
	植：今は%(植物段階名)。これまでに%(_lap)回、咲いた。
	ラ：水も%(水やり回数取得)回もらってるしな。
	植：次の変化まで、あと%(_zan)時間くらい。
	：何回でも咲くよ。
	">>
}

//------------------------------------------------------------------------------
// 喋る間隔（aitalkinterval は秒。0でランダムトーク停止）
//------------------------------------------------------------------------------
Menu_INTERVAL
{
	<<"
	植：どれくらいがいい？
	＠半分メニュー：とても多い（15秒）｜Menu_INTERVAL_SET｜15
	＠半分メニュー：よく喋る（1分）｜Menu_INTERVAL_SET｜60
	＠半分メニュー：ふつう（3分）｜Menu_INTERVAL_SET｜180
	＠半分メニュー：ひかえめ（10分）｜Menu_INTERVAL_SET｜600
	＠半分メニュー：黙る｜Menu_INTERVAL_SET｜0
	＠改行多めメニュー：戻る｜Menu_CONFIG
	">>
}

Menu_INTERVAL_SET
{
	//---- 追加引数は OnChoiceSelectEx 経由で 選択肢引数 に入っている
	aitalkinterval = TOINT(選択肢引数取得(0))

	//---- 「黙る」を自分で選んだ時だけフラグを立てる。
	//     これが無いと、何かの拍子に0になった時に
	//     二度とランダムトークが戻らなくなる（下の自己修復用）。
	黙る設定 = 0
	if aitalkinterval == 0 {
		黙る設定 = 1
	}

	if aitalkinterval == 0 {
		<<"
		植：わかった。静かにしてる。
		ラ：呼びたくなったらメニューからな。
		">>
		return
	}

	//---- 60秒未満は「分」だと0になってしまうので、秒で答える
	if aitalkinterval < 60 {
		<<"
		植：じゃあ、%(aitalkinterval)秒おきくらいで。
		ラ：かなり喋るぞ、それ。
		植：うるさかったら、また変えて。
		">>
		return
	}

	<<"
	植：じゃあ、%(aitalkinterval / 60)分おきくらいで。
	ラ：了解。
	">>
}


//==============================================================================
// 名前を教わる
// 「名前入力起動('メニュー')」の引数が、下の関数名の末尾に付く。
//==============================================================================
Menu_TELLNAME
{
	名前入力起動('メニュー')
}

名前入力開くメニュー
{
	<<"
	植：名前、教えてくれる？
	ラ：呼び方が決まってないとやりづらいからな。
	">>
}

名前入力空欄メニュー
{
	<<"
	植：……なにも書いてない。
	ラ：もう一回聞いてみろって。
	">>
}

名前入力敬称メニュー
{
	<<"
	植：敬称は、こっちで付けるから大丈夫。
	ラ：名前だけでいいぞ。
	">>
}

名前入力終了メニュー
{
	<<"
	植：（ユーザー）。
	：おぼえた。
	ラ：これからよろしくな、（ユーザー）。
	">>
}


//==============================================================================
// 選択肢を放置した時
//==============================================================================
選択肢時間切れ
{
	<<"
	植：……行っちゃった。
	ラ：戻ってきたらまた聞こう。
	">>
}
