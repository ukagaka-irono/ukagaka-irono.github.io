//******************************************************************************
// 植本とラフウ
// 花の図鑑辞書（咲くたびに花の名前が変わる・アルバム）
//
// 咲く花は6種類。絵はどれも同じ（シェルのピンクの花）なので、
// それと食い違わないピンク系の花から選んでいる。
// 決め方：まだ咲いていない種類から選ぶ。全部そろったら6種類からランダム。
// 花の名前は、植物が段階6（花）になった時に 花が咲いた（植物が育つ から呼ばれる）で決まる。
//
// 記録（グローバル変数。yaya_variable.cfg に残る）
//   花回数0〜5            … その種類が咲いた回数
//   花初日0〜5            … その種類が初めて咲いた日（2026/10/24 の形）
//   今咲いている花        … 最後に咲いた花の番号（まだなら -1）
//   今咲いている花の周回  … その花が何周目に咲いたか（植物周回数 と同じなら今咲いている）
//   名前のわからない花の数 … この仕組みを入れる前に咲いた回数（入れた時に一度だけ数える）
//   花図鑑の開始          … 上を数え終えた印
//   花図鑑そろった        … 6種類そろったお祝いをした印
//******************************************************************************

//---- 花の種類（番号は記録の変数名に使うので、並びを変えないこと。足す時は末尾に）
花の名前 : array
{
	'なでしこ'
	'さくらそう'
	'コスモス'
	'ゼラニウム'
	'スイートピー'
	'ペチュニア'
}

花の種類数
{
	ARRAYSIZE(花の名前)
}

//---- その種類が咲いた回数
花回数取得
{
	_v = '花回数' + TOSTR(_argv[0])
	if ISVAR(_v) {
		TOINT(EVAL(_v))
	}
	else {
		0
	}
}

//---- その種類が初めて咲いた日（まだなら空）
花初日取得
{
	_v = '花初日' + TOSTR(_argv[0])
	if ISVAR(_v) {
		EVAL(_v)
	}
	else {
		''
	}
}

//---- 何種類あつめたか
あつめた花の数
{
	_c = 0
	_n = 花の種類数
	for _i = 0; _i < _n; _i++ {
		if 花回数取得(_i) > 0 {
			_c++
		}
	}
	_c
}

名前のわからない花の数取得
{
	if ISVAR('名前のわからない花の数') {
		TOINT(名前のわからない花の数)
	}
	else {
		0
	}
}

//---- 今、名前の決まった花が咲いているか（1 = 咲いている）
花が咲いているか
{
	if 植物段階 < 6 {
		0
		return
	}
	if !ISVAR('今咲いている花') || !ISVAR('今咲いている花の周回') {
		0
		return
	}
	if TOINT(今咲いている花) < 0 {
		0
		return
	}
	if TOINT(今咲いている花の周回) != 植物周回数 {
		0
		return
	}
	1
}

//---- 今咲いている花の名前（咲いていなければ空）
今咲いている花名
{
	if !花が咲いているか {
		''
		return
	}
	花の名前[TOINT(今咲いている花)]
}

//------------------------------------------------------------------------------
// 咲く花を決めて記録する。初めての種類なら 1 を返す。
//------------------------------------------------------------------------------
花を決める
{
	_n = 花の種類数

	//---- まだ咲いていない種類から。全部そろっていたら全部から。
	_cand = IARRAY
	for _i = 0; _i < _n; _i++ {
		if 花回数取得(_i) == 0 {
			_cand ,= _i
		}
	}
	if ARRAYSIZE(_cand) == 0 {
		for _i = 0; _i < _n; _i++ {
			_cand ,= _i
		}
	}

	_idx = _cand[RAND(ARRAYSIZE(_cand))]
	_new = 0
	if 花回数取得(_idx) == 0 {
		_new = 1
		_t = GETTIME
		LETTONAME('花初日' + TOSTR(_idx), "%(_t[0])/%(_t[1])/%(_t[2])")
	}
	LETTONAME('花回数' + TOSTR(_idx), 花回数取得(_idx) + 1)

	今咲いている花 = _idx
	今咲いている花の周回 = 植物周回数

	_new
}

//------------------------------------------------------------------------------
// この仕組みを入れた時の引き継ぎ（辞書を読み込むたびに確かめる）
//   ・前から使っている人の、これまでに咲いた回数を「名前のわからない花」にする
//   ・ちょうど花が咲いているのに名前が無ければ、黙って決めておく
//------------------------------------------------------------------------------
ゴースト起動前の処理_花図鑑 : void
{
	if !ISVAR('花図鑑の開始') {
		花図鑑の開始 = 1
		名前のわからない花の数 = 植物周回数
		今咲いている花 = -1
		今咲いている花の周回 = -1
	}

	if 植物段階 >= 6 && !花が咲いているか {
		void 花を決める
	}
}


//==============================================================================
// 花が咲いた時（植物が育つ の段階6から呼ばれる）
//==============================================================================
花が咲いた
{
	_first = (植物周回数 <= 0 && 名前のわからない花の数取得 == 0)
	_new   = 花を決める
	_i     = TOINT(今咲いている花)
	_name  = 花の名前[_i]

	_t = ''
	if _first {
		//---- 生まれて初めて花が咲いた時は、前からある言葉に名前を続ける
		_t = 最初の開花 + C_CRLF + 'ラ：なんて花なんだ？' + C_CRLF + "植：……%(_name)、だと思う。"
	}
	elseif _new {
		_t = EVAL('初めて咲いた花' + TOSTR(_i))
	}
	else {
		_t = また咲いた花(_name)
	}

	//---- 6種類そろった時は、一度だけお祝い
	if _new && あつめた花の数 >= 花の種類数 && !ISVAR('花図鑑そろった') {
		花図鑑そろった = 1
		_t = _t + C_CRLF + '=====' + C_CRLF + 図鑑がそろった
	}

	_t
}

最初の開花
{
	<<"
	植：咲いた。
	ラ：咲いたなあ。
	植：（ユーザー）が、ずっと一緒にいてくれたからだと思う。
	ラ：……たまにはいいこと言うじゃないか。
	植：たまには言う。
	">>
}

//---- 初めての種類が咲いた時（番号は 花の名前 の並び）
初めて咲いた花0
{
	<<"
	植：咲いた。
	：……なでしこ、だと思う。
	ラ：へえ。花びらがぎざぎざしてるな。
	植：うん。そこが、かわいい。
	">>
}

初めて咲いた花1
{
	<<"
	植：咲いた。……さくらそう。
	ラ：桜に似てるからか？
	植：たぶん。小さい桜。
	ラ：頭の上で花見だな。
	">>
}

初めて咲いた花2
{
	<<"
	植：コスモス、咲いた。
	ラ：秋の花じゃなかったか？
	植：ウエモトの頭は、いつでも咲く。
	ラ：便利な頭だな。
	">>
}

初めて咲いた花3
{
	<<"
	植：ゼラニウム。
	ラ：急に難しい名前だな。
	植：言いにくい。
	ラ：お前が咲かせたんだろ。
	">>
}

初めて咲いた花4
{
	<<"
	植：スイートピー、咲いた。
	ラ：なんか、ひらひらしてるな。
	植：蝶みたいって言われる花。
	ラ：飛んでいくなよ。
	植：飛ばない。根がある。
	">>
}

初めて咲いた花5
{
	<<"
	植：ペチュニア。
	ラ：聞いたことあるような、ないような。
	植：花壇によくいる。
	ラ：じゃあ、お前の頭も花壇か。
	植：小さい花壇。
	">>
}

//---- 同じ種類がまた咲いた時（_argv[0] に花の名前）
また咲いた花
{
	_name = _argv[0]

	<<"
	植：咲いた。……また、%(_name)。
	ラ：おなじみだな。
	植：うん。何回見ても、いい。
	">>

	<<"
	ラ：お、%(_name)か。
	植：また会えた。
	ラ：花に言ってるのか、それ。
	植：うん。
	">>
}

//---- 6種類そろった時
図鑑がそろった
{
	<<"
	ラ：おい植本、これで全部そろったんじゃないか。
	植：……ほんとだ。6種類。
	：（ユーザー）のおかげ。
	ラ：これからは、どれが咲くかお楽しみだな。
	">>
}


//==============================================================================
// アルバム（植物の様子 から開く）
//
// 咲いたことのある花は選べるようにして、選ぶとその花のひとことを話す。
// 選択肢の追加引数（花の番号）は menu.dic の OnChoiceSelectEx 経由で受け取る。
//==============================================================================
Menu_ALBUM
{
	_n = 花の種類数
	_t = "植：あつめた花、%(あつめた花の数)／%(_n)。"

	//---- この仕組みを入れる前に咲いた分（前から使っている人だけ）
	_u = 名前のわからない花の数取得
	if _u > 0 {
		_t += C_CRLF + "：ほかに、名前のわからない花が%(_u)回。"
	}

	//---- 行の並びがそろうよう、まだの花も選べる項目にしておく
	for _i = 0; _i < _n; _i++ {
		_c = 花回数取得(_i)
		if _c > 0 {
			_t += C_CRLF + "＠メニュー：%(花の名前[_i])　%(花初日取得(_i))　%(_c)回｜Menu_ALBUM_FLOWER｜%(_i)"
		}
		else {
			_t += C_CRLF + "＠メニュー：？？？｜Menu_ALBUM_FLOWER｜%(_i)"
		}
	}

	_t += C_CRLF + '＠改行多めメニュー：とじる｜Menu_CANCEL'
	_t
}

Menu_ALBUM_FLOWER
{
	_i = TOINT(選択肢引数取得(0))
	if _i < 0 || _i >= 花の種類数 {
		return
	}

	if 花回数取得(_i) == 0 {
		<<"
		植：それは、まだ咲いたことない。
		ラ：何が咲くかは、咲いてからのお楽しみだな。
		">>
		return
	}
	_c = 花回数取得(_i)

	EVAL('アルバムの花' + TOSTR(_i)) + C_CRLF + "：これまでに%(_c)回、咲いたな。"
}

//---- アルバムで選んだ時のひとこと（番号は 花の名前 の並び）
アルバムの花0
{
	<<"
	植：なでしこ。ぎざぎざの花びら。
	ラ：咲いた日は、ちょっと誇らしげだったな。
	">>
}

アルバムの花1
{
	<<"
	植：さくらそう。小さい桜。
	ラ：頭の上で花見したやつだな。
	">>
}

アルバムの花2
{
	<<"
	植：コスモス。秋っぽいけど、いつでも咲く。
	ラ：お前の頭は季節を気にしないからな。
	">>
}

アルバムの花3
{
	<<"
	植：ゼラニウム。……言えた。
	ラ：練習したのか。
	">>
}

アルバムの花4
{
	<<"
	植：スイートピー。ひらひら。
	ラ：飛んでいかなくてよかったよ。
	">>
}

アルバムの花5
{
	<<"
	植：ペチュニア。小さい花壇。
	ラ：また咲くといいな。
	">>
}


//==============================================================================
// 話しかけで花の名前が出た時（talk_communicate.dic から。_argv[0] に花の番号）
//==============================================================================
花の話
{
	_i    = TOINT(_argv[0])
	_name = 花の名前[_i]
	_c    = 花回数取得(_i)

	if 今咲いている花名 == _name {
		<<"
		植：%(_name)、いま頭に咲いてる。
		ラ：よく見せてやれよ。
		植：……どう？
		">>
		return
	}

	if _c > 0 {
		_d = 花初日取得(_i)
		<<"
		植：%(_name)、咲いたことある。
		：はじめては、%(_d)。
		ラ：よくおぼえてるな。
		">>
		return
	}

	<<"
	植：%(_name)……まだ、咲いたことない。
	ラ：そのうち咲くかもな。
	植：咲いたら、見せる。
	">>
}


//==============================================================================
// 咲いている花ごとのランダムトーク
//
// plant.dic の「あやりりす・日付イベントユーザー定義」に 咲いている花スロット を
// 並べてあるので、名前の決まった花が咲いている間だけ、その花のトークが候補に入る。
// 咲いていない時は、使わない名前「咲いている花なし」を返す（空だと「ランダムトーク」
// そのものが候補に入ってしまうため）。
//==============================================================================
咲いている花スロット
{
	_name = 今咲いている花名
	if STRLEN(_name) {
		'咲いている花' + _name
	}
	else {
		'咲いている花なし'
	}
}

ランダムトーク咲いている花なでしこ : array
{
	<<'
	植：なでしこって、なでたくなる子、って意味らしい。
	ラ：じゃあ撫でてやるか。
	植：……どうぞ。
	'>>

	<<'
	ラ：花びらのぎざぎざ、自分で切ったのか？
	植：咲いた時から、こう。
	ラ：おしゃれだな。
	'>>
}

ランダムトーク咲いている花さくらそう : array
{
	<<'
	植：頭の上で、小さいお花見。
	ラ：オレも混ぜてくれ。
	植：特等席、あげる。
	'>>

	<<'
	ラ：本物の桜と違って、すぐには散らないな。
	植：うん。ゆっくり見てて。
	'>>
}

ランダムトーク咲いている花コスモス : array
{
	<<'
	植：コスモスは、風が吹いても平気。
	ラ：細いのにな。
	植：しなるから、折れない。
	ラ：……お前に似てるかもな。
	'>>

	<<'
	ラ：秋桜って書くんだったか。
	植：うん。いまは、ずっと秋。
	ラ：頭の上だけな。
	'>>
}

ランダムトーク咲いている花ゼラニウム : array
{
	<<'
	植：ゼラニウム、ゼラニウム。
	ラ：練習してるのか。
	植：すらすら言えるようになりたい。
	'>>

	<<'
	ラ：この花、ちょっと変わった匂いがするな。
	植：虫よけになるって聞いた。
	ラ：じゃあオレも寄りつかなくなるのか。
	植：ラフウは虫じゃない。
	'>>
}

ランダムトーク咲いている花スイートピー : array
{
	<<'
	植：スイートピーは、春の花。
	ラ：今は何月だったかな。
	植：気にしない。
	'>>

	<<'
	ラ：ひらひらしてるな、相変わらず。
	植：風が吹くと、ちょっと楽しい。
	'>>
}

ランダムトーク咲いている花ペチュニア : array
{
	<<'
	植：ペチュニアは、たくさん咲く花。
	ラ：一個しか咲いてないぞ。
	植：……これから。
	ラ：期待しとく。
	'>>

	<<'
	ラ：花壇の主役って感じだな。
	植：主役。
	ラ：照れるなよ。
	'>>
}
