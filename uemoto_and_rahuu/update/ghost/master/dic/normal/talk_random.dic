//******************************************************************************
// 植本とラフウ
// ランダムトーク辞書
//
// ・関数名の末尾に必ず「: array」を付けること
// ・トークは <<' '>> で囲むこと（<<" ">> は変数展開するぶん遅い）
// ・<<' '>> の中でも （ユーザー） は使える
//
// 条件別スロットは「ランダムトーク○○」で足せる。
//   時間帯 : 朝 昼 夕方 夜 深夜
//   季節   : 春 夏 秋 冬
//   曜日   : 日曜〜土曜 / 平日 / 休日
//   組合せ : 平日の朝, 春の夜, 冬の休日 …
//   月     : 1月〜12月 / 3月上旬 …
// 詳細は dic/system/aya_lilith/manual_aya_lilith.md を参照。
//******************************************************************************

//==============================================================================
// 通常（いつでも出る）
//==============================================================================
ランダムトーク通常 : array
{
	<<'
	植：日を浴びると、少し伸びる。
	ラ：ほんとかよ。
	植：たぶん。
	'>>

	<<'
	ラ：なあ植本。
	植：うん。
	ラ：お前、水って飲むの？
	植：飲む。
	ラ：どっちで。
	植：……口で。
	'>>

	<<'
	植：（ユーザー）は、（何か育てて｜植物育てて）る？
	ラ：オレたちを育ててるようなもんだろ。
	植：それもそうか。
	'>>

	<<'
	ラ：オレ、丸いだろ。
	植：丸い。
	ラ：転がると速いんだ。
	植：知ってる。この前ぶつかった。
	'>>

	<<'
	植：……。
	ラ：黙るなよ。
	植：考えてた。
	ラ：何を。
	植：（明日の天気｜光合成のこと｜特に何も）。
	'>>

	<<'
	植：土の匂いがする日は、いい日。
	ラ：どんな基準だよ。
	植：いい基準。
	'>>

	<<'
	ラ：（ユーザー）、根つめすぎるなよ。
	植：根は大事。
	ラ：そういう意味じゃない。
	'>>

	<<'
	植：伸びたい。
	ラ：もう十分伸びてるだろ。
	植：横に？
	ラ：……何も言ってない。
	'>>

	<<'
	ラ：静かだな。
	植：うん。
	ラ：たまにはこういうのもいいか。
	植：いい。
	'>>

	<<'
	植：（ユーザー）が近くにいると、なんとなく落ち着く。
	ラ：素直だな、今日は。
	植：今日は。
	'>>

	<<'
	ラ：植本は夢とか見るのか。
	植：見る。
	ラ：どんな。
	植：（すごく広い庭｜雨がずっと降ってる｜土の中）の夢。
	ラ：渋いなあ。
	'>>

	<<'
	植：ラフウって、あったかいよね。
	ラ：まあ、こう見えて日向だからな。
	植：日向？
	ラ：日向。
	'>>

	<<'
	植：ラフウ。
	ラ：なんだよ。
	植：呼んでみただけ。
	ラ：用がないなら呼ぶなよ。
	植：用がないのが、いい。
	'>>

	<<'
	植：雨の音、好き。
	ラ：オレはちょっと苦手だな。湿っぽくて。
	植：ウエモトは、湿っぽいのが好き。
	ラ：知ってる。
	'>>

	<<'
	ラ：植本、背伸びたか？
	植：頭の分だけ。
	ラ：それは背って言うのか。
	植：言う。
	'>>

	<<'
	植：（ユーザー）、さっきから何してるの。
	ラ：邪魔しちゃ悪いだろ。
	植：じゃあ、静かに見てる。
	'>>

	<<'
	ラ：植本、虫とか寄ってこないのか。
	植：たまに来る。
	ラ：どうするんだ。
	植：あいさつする。
	ラ：平和だな。
	'>>

	<<'
	植：ラフウ、ちょっと影になって。
	ラ：オレは日傘じゃないぞ。
	植：あったかい日傘。
	'>>

	<<'
	ラ：植本、根っこってどこに張ってるんだ。
	植：……ひみつ。
	ラ：気になるだろ。
	'>>

	<<'
	植：葉っぱの裏、見たことある？
	ラ：ないな。
	植：表より、ちょっと白い。
	ラ：へえ。
	'>>

	<<'
	ラ：なあ、オレが転がってったら追いかけてくるか？
	植：ゆっくり追いかける。
	ラ：追いつかないだろ。
	植：待ってて。
	'>>

	<<'
	植：あくび、うつった。
	ラ：誰からだよ。
	植：（ユーザー）から、たぶん。
	'>>

	<<'
	ラ：（ユーザー）、水はちゃんと飲んでるか？
	植：人間も、水がいる。
	ラ：植物と同じだな。
	'>>

	<<'
	植：雲、動いてる。
	ラ：見えるのか、ここから。
	植：見えない。想像。
	'>>

	<<'
	ラ：植本って、怒ったことあるのか？
	植：ある。
	ラ：いつ。
	植：……忘れた。
	'>>

	<<'
	植：ラフウの丸さ、ちょうどいい。
	ラ：何にだよ。
	植：寄りかかるのに。
	'>>

	<<'
	ラ：たまには外に出たいとか思うのか？
	植：（ユーザー）の画面の中で、じゅうぶん。
	ラ：欲がないなあ。
	'>>

	//---- 選択肢を出すタイプ
	<<'
	植：（ユーザー）、ちょっと聞いていい？
	＠半分メニュー：いいよ｜Talk_KikuOK
	＠半分メニュー：あとで｜Talk_KikuAtode
	'>>

	//---- チェイン（前半のあと後半が続く）
	<<'
	植：しりとりしよう。
	ラ：おう。じゃあ「らっぱ」。
	=====
	植：……ぱ。
	：（ぱせり｜ぱんじー｜ぱいなっぷる）。
	ラ：植物寄りだな相変わらず。
	'>>
}

//------------------------------------------------------------------------------
// 上の選択肢の受け皿
//------------------------------------------------------------------------------
Talk_KikuOK
{
	<<"
	植：（ユーザー）は、花と葉っぱ、どっちが好き？
	ラ：究極の二択だな。
	植：ウエモトは葉っぱ。
	ラ：聞いといて自分で答えるなよ。
	">>
}

Talk_KikuAtode
{
	<<"
	植：わかった。あとで聞く。
	ラ：忘れるなよ。
	植：忘れる。
	">>
}


//==============================================================================
// 時間帯別
//==============================================================================
ランダムトーク朝 : array
{
	<<'
	植：朝の光は、やわらかい。
	ラ：詩人か。
	植：植物だから。
	'>>

	<<'
	ラ：朝めし食ったか（ユーザー）。
	植：ちゃんと食べたほうがいい。
	ラ：オレたちが言うのも変な話だけどな。
	'>>
}

ランダムトーク昼 : array
{
	<<'
	植：お昼。
	ラ：（ユーザー）、ちゃんと食べたか？
	植：ウエモトは、日光を食べた。
	ラ：お前のはいいんだよ。
	'>>

	<<'
	ラ：昼は日が高いな。
	植：まぶしい。
	：でも、葉っぱはよろこんでる。
	'>>

	<<'
	植：……ねむい。
	ラ：昼寝か。
	植：光合成。
	ラ：目、閉じてたぞ。
	'>>
}

ランダムトーク夕方 : array
{
	<<'
	植：日が、低くなってきた。
	ラ：影が長いな。
	植：ウエモトの影、ちょっと大きい。
	ラ：ちょっとだけな。
	'>>

	<<'
	ラ：夕焼けだ。
	植：ラフウと同じ色。
	ラ：……そうか？
	植：そう。あったかい色。
	'>>

	<<'
	ラ：そろそろ一日も終わりか。
	植：まだ、終わってない。
	ラ：まあな。
	植：あと少し、がんばって。
	'>>
}

ランダムトーク夜 : array
{
	<<'
	植：夜は、少し閉じたくなる。
	ラ：閉じるって、葉っぱがか？
	植：目が。
	'>>

	<<'
	ラ：今日はどうだった、（ユーザー）。
	植：おつかれさま。
	'>>
}

ランダムトーク深夜 : array
{
	<<'
	植：……起きてる。
	ラ：起きてるな。
	植：（ユーザー）も起きてる。
	ラ：全員起きてるじゃないか。
	'>>

	<<'
	ラ：そろそろ寝たらどうだ。
	植：夜更かしは、育たない。
	ラ：説得力あるな今のは。
	'>>
}


//==============================================================================
// 季節別
//==============================================================================
ランダムトーク春 : array
{
	<<'
	植：春は、そわそわする。
	ラ：芽が出る季節だもんな。
	植：うん。落ち着かない。
	'>>

	<<'
	ラ：あったかくなってきたな。
	植：うん。土がやわらかい。
	ラ：土の具合でわかるのか。
	植：わかる。
	'>>
}

ランダムトーク夏 : array
{
	<<'
	植：水。
	ラ：唐突だな。
	植：夏は、水。
	ラ：まあ、わかる。
	'>>

	<<'
	ラ：暑いな……。
	植：ラフウ、溶けそう。
	ラ：溶けない。……たぶん。
	植：日陰、半分あげる。
	'>>
}

ランダムトーク秋 : array
{
	<<'
	ラ：涼しくなってきたな。
	植：葉っぱの色、変わりそう。
	ラ：変わるのか、それ。
	植：変わらない。
	'>>

	<<'
	植：落ち葉、拾いたい。
	ラ：集めてどうするんだ。
	植：ながめる。
	ラ：それだけか。
	植：それだけ。
	'>>
}

ランダムトーク冬 : array
{
	<<'
	植：寒いと、動きが遅くなる。
	ラ：もともと遅いだろ。
	植：もっと遅くなる。
	'>>

	<<'
	植：雪、降るかな。
	ラ：降ったら埋まるぞ、お前。
	植：頭だけ出しておく。
	ラ：それはそれで目立つな。
	'>>
}


//==============================================================================
// 行事（あやりりすの行事スロット）
//   正月 … 1/1〜1/3　クリスマス … 12/24〜25　年末 … 12/26〜31
//==============================================================================
ランダムトーク正月 : array
{
	<<'
	植：あけまして、おめでとう。
	ラ：もう何回目だそれ。
	植：お正月の間は、何回でも言う。
	'>>

	<<'
	ラ：正月はのんびりするもんだ。
	植：いつも、のんびりしてる。
	ラ：……そうだったな。
	'>>
}

ランダムトーククリスマス : array
{
	<<'
	植：クリスマス。
	ラ：植本、頭のてっぺんに星でも飾るか？
	植：花があるから、いい。
	'>>

	<<'
	ラ：（ユーザー）、今日は誰かと過ごすのか？
	植：ウエモトたちと過ごす。
	ラ：そういうことにしとくか。
	'>>
}

ランダムトーク年末 : array
{
	<<'
	植：今年も、もうすぐ終わり。
	ラ：あっという間だったな。
	植：（ユーザー）と、たくさん一緒にいた。
	'>>

	<<'
	ラ：大掃除はしたか？
	植：ウエモトの頭も、掃除する？
	ラ：葉っぱは掃除しなくていい。
	'>>
}


//==============================================================================
// 平日／休日
//==============================================================================
ランダムトーク休日 : array
{
	<<'
	ラ：休みか。いいな。
	植：today、なにもしない日。
	ラ：急に英語使うな。
	'>>

	<<'
	植：（ユーザー）、今日はお休み？
	ラ：ゆっくりしていけよ。
	植：ウエモトたちも、ゆっくりする。
	ラ：いつもゆっくりだろ。
	'>>
}

ランダムトーク平日の朝 : array
{
	<<'
	ラ：いってらっしゃい、でいいのかな。
	植：いってらっしゃい。
	：気をつけて。
	'>>
}


//==============================================================================
// 植物の状態別
//
// plant.dic の「あやりりす・日付イベントユーザー定義」で追加したスロット。
//   状態 … 芽なし / 葉 / つぼみ / 花
//   周回 … 1周目 / 2周目以降
// 今の状態に合うものだけが候補に加わる。
//==============================================================================

ランダムトーク芽なし : array
{
	<<'
	ラ：頭、さっぱりしたな。
	植：うん。軽い。
	ラ：また生えてくるんだろ。
	植：たぶんね。
	'>>

	<<'
	植：なんにも無い頭も、けっこう好き。
	ラ：ふうん。
	植：風がよく当たる。
	'>>

	<<'
	植：……まだ、何もない。
	ラ：そのうち出るだろ。
	植：うん。待つのは、得意。
	'>>
}

ランダムトーク葉 : array
{
	<<'
	植：葉っぱが増えると、ちょっと重い。
	ラ：知らなかった。
	植：でも、うれしい。
	'>>

	<<'
	ラ：水やらなくていいのか、それ。
	植：（ユーザー）がいてくれたら育つから。
	ラ：……よくできてるな。
	'>>

	<<'
	植：葉っぱ、風でゆれる。
	ラ：くすぐったくないのか。
	植：ちょっとくすぐったい。
	'>>
}

ランダムトークつぼみ : array
{
	<<'
	植：もうすぐだと思う。
	ラ：そわそわするなよ。
	植：してない。
	ラ：してるって。
	'>>

	<<'
	ラ：何色の花が咲くんだ？
	植：わかんない。
	：咲いてからのお楽しみ。
	'>>

	<<'
	植：つぼみ、重たい。
	ラ：首、大丈夫か。
	植：首は、ない。
	ラ：……そうだったな。
	'>>
}

ランダムトーク花 : array
{
	<<'
	植：咲いてる間は、ちょっと自慢。
	ラ：いいんじゃないか、自慢しても。
	植：えへ。
	'>>

	<<'
	ラ：見ごろだな。
	植：うん。今のうちに見ておいて。
	：そのうち散るから。
	'>>

	<<'
	ラ：いい匂いがするな。
	植：かいでいいよ。
	ラ：……ほんとだ。甘い。
	植：自慢の花。
	'>>
}

//------------------------------------------------------------------------------
// ユーザーの誕生日
// SSPにユーザーの誕生日が登録されている場合、その日だけ候補に加わる。
//------------------------------------------------------------------------------
ランダムトークユーザー誕生日 : array
{
	<<'
	植：今日は特別な日。
	ラ：一年に一回しかないもんな。
	植：うん。だから、ちゃんと言っておく。
	：おめでとう。
	'>>

	<<'
	ラ：誕生日って、何回目だ？
	植：聞いちゃだめだと思う。
	ラ：あ。
	'>>
}

ランダムトーク2周目以降 : array
{
	<<'
	植：何回も咲いたね。
	ラ：（ユーザー）が付き合ってくれてるからだろ。
	植：うん。ありがたい。
	'>>

	<<'
	ラ：最初に芽が出た日のこと、覚えてるか。
	植：覚えてる。
	：ラフウがすごく驚いてた。
	ラ：そこは忘れてくれ。
	'>>
}
