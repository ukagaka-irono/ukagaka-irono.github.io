//******************************************************************************
// 植本とラフウ
// マウス反応辞書
//
// 関数名 = [種別] + [スコープ番号] + [当たり判定名]
//
// shell/master/surfaces.txt で定義した当たり判定：
//   \0（植本） : Face / Head / Body / Foot / Plant（Plantはsurface1〜6のみ）
//   \1（ラフウ）: Antenna / Face / Body
//
// 当たり判定名を省略（例：なでなで0）すると、どこを触っても反応する。
// 種別は なでなで／クリック／ダブルクリック／多重クリック／右クリック／
//        ころころ上／ころころ下／ホールド／マウスホバー など。
// 詳細は dic/system/aya_lilith/manual_aya_lilith.md を参照。
//******************************************************************************

//==============================================================================
// なで連打のカウンタ（自前実装）
//
// あやりりすの「マウスイベント連続回数」は なでなで では使えない。
// MouseEventExecFromEventName が なでなで に -1 を返すため、
// 加算処理そのものが飛ばされて中身が空文字になる。
// （クリック系ところころ系でしか機能しない）
//
// そのため、同じ場所を続けて撫でられた回数を自分で数える。
// なでなでのトークは数秒かかり、その間は次のなでなでが発火しないので、
// あやりりすの3秒判定より広めの窓を取っている。
//==============================================================================

//---- 連続とみなす間隔（ミリ秒）
なで連続判定時間
{
	15000
}

//------------------------------------------------------------------------------
// 引数に部位を表す任意の文字列を渡すと、その連続回数を返す（初回は1）
//------------------------------------------------------------------------------
なで連続回数
{
	_now  = GETTICKCOUNT
	_win  = TOINT(なで連続判定時間)

	_last = 0
	if ISVAR('なで最終時刻') {
		_last = TOINT(なで最終時刻)
	}
	_diff = _now - _last

	_same = 0
	if ISVAR('なで最終部位') {
		if なで最終部位 == _argv[0] {
			_same = 1
		}
	}

	//---- 同じ部位を、判定時間内に、続けて撫でられたか
	//     _diff が負になるのはOS再起動でGETTICKCOUNTが巻き戻った時。その場合は初回扱い。
	_c = 1
	if _same && _diff >= 0 && _diff < _win {
		if ISVAR('なで連続') {
			_c = TOINT(なで連続) + 1
		}
		else {
			_c = 2
		}
	}

	なで連続     = _c
	なで最終時刻 = _now
	なで最終部位 = _argv[0]

	_c
}


//==============================================================================
// 植本（\0）
//==============================================================================

//---- 頭の植物
なでなで0Plant
{
	<<"
	植：……くすぐったい。
	ラ：そこ触られるの好きだよな。
	植：好きじゃない。
	">>

	<<"
	植：あ。
	ラ：どうした。
	植：（ユーザー）が、葉っぱ触ってる。
	ラ：やさしくしてやってくれよ。
	">>
}

クリック0Plant
{
	<<"
	植：折れる。
	ラ：折れないだろ。
	植：折れないけど、びっくりする。
	">>
}

//---- 頭
//    撫でられ続けると反応が変わっていく
なでなで0Head
{
	_n = なで連続回数('0Head')

	//---- しつこい
	if _n >= 8 {
		<<"
		植：……。
		ラ：おい、こいつ黙ったぞ。
		植：もう、好きにして。
		ラ：怒ってるなこれ。
		">>
		return
	}

	//---- だいぶ照れてきた
	if _n >= 6 {
		<<"
		植：……そんなに撫でても、
		：早くは育たないよ。
		ラ：それはそれとして嬉しいんだろ。
		植：……うん。
		">>
		return
	}

	//---- 少し照れる
	if _n >= 3 {
		<<"
		植：……くすぐったくなってきた。
		ラ：顔がゆるんでるぞ。
		植：ゆるんでない。
		">>
		return
	}

	//---- 通常
	<<"
	植：ん。
	：……もうちょっと。
	">>

	<<"
	ラ：気持ちよさそうだな。
	植：うん。
	">>

	<<"
	植：（ユーザー）の手、あったかい。
	">>
}

ダブルクリック0Head
{
	<<"
	植：はい。
	ラ：反応うすいな。
	植：これでも喜んでる。
	">>
}

//---- 顔
なでなで0Face
{
	<<"
	植：（顔｜くちばし）はくすぐったい。
	ラ：さっきもくすぐったいって言ってたぞ。
	植：ぜんぶくすぐったい。
	">>
}

ダブルクリック0Face
{
	<<"
	植：目、つつかないで。
	ラ：つついてないだろ。
	">>
}

//---- 胴
なでなで0Body
{
	<<"
	植：もふもふしてる？
	ラ：してるしてる。
	植：よかった。
	">>

	<<"
	植：……。
	：眠くなる。
	">>
}

ダブルクリック0Body
{
	<<"
	植：ぽふ。
	ラ：今の効果音、自分で言ったのか。
	植：言った。
	">>
}

//---- 足
なでなで0Foot
{
	<<"
	植：あし。
	ラ：足だな。
	植：意外と速い。
	ラ：嘘つけ。
	">>
}

//---- ホイール
ころころ上0
{
	<<"
	植：うわ。
	ラ：伸びた伸びた。
	">>
}

ころころ下0
{
	<<"
	植：縮んだ。
	ラ：戻れよ。
	">>
}

//---- 長押し
ホールド0Head
{
	<<"
	植：……ずっと触ってる。
	ラ：まあ、好きにさせとけ。
	植：うん。
	">>
}

//---- 喋っている最中に撫でられた時（通常の なでなで0Head より優先される）
トーク中なでなで0Head
{
	<<"
	植：今、喋ってる。
	ラ：あとにしてやれって。
	">>
}


//==============================================================================
// ラフウ（\1）
//==============================================================================

//---- 触角
なでなで1Antenna
{
	<<"
	ラ：おわっ、そこはやめろ。
	植：弱点。
	ラ：ばらすな。
	">>
}

クリック1Antenna
{
	<<"
	ラ：ぴん、て鳴った気がした。
	植：鳴ってない。
	">>
}

//---- 顔
なでなで1Face
{
	<<"
	ラ：お、いいね。
	植：ラフウは正直。
	ラ：正直が一番だろ。
	">>
}

ダブルクリック1Face
{
	<<"
	ラ：なんだなんだ。
	植：呼ばれてる。
	">>
}

//---- 胴
なでなで1Body
{
	_n = なで連続回数('1Body')

	if _n >= 6 {
		<<"
		ラ：さすがに撫ですぎだろ。
		植：ラフウ、平べったくなってきた。
		ラ：なってない。
		">>
		return
	}

	if _n >= 3 {
		<<"
		ラ：……なあ、そろそろ。
		植：ラフウ、顔が赤い。
		ラ：もとから赤いんだよ！
		">>
		return
	}

	<<"
	ラ：まるいだろ。
	植：まるい。
	ラ：自慢なんだ、これ。
	">>

	<<"
	ラ：あー、あったかいな。
	植：ラフウはもともとあったかい。
	">>
}

ダブルクリック1Body
{
	<<"
	ラ：ころん。
	植：転がった。
	ラ：転がってない。
	">>
}

//---- ホイール
ころころ1
{
	<<"
	ラ：まわるまわる。
	植：目が回りそう。
	">>
}
