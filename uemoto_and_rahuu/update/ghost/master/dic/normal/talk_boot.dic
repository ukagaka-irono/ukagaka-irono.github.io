//******************************************************************************
// 植本とラフウ
// 起動・終了トーク辞書
//
// 記法：あやりりすEX
//   植  = \0（植本）  ラ = \1（ラフウ）
//   「植：」のようにサーフィス番号を省略すると、
//   現在の植物段階（plant.dic参照）が自動で選ばれる。
//******************************************************************************

//==============================================================================
// 起動して最初に喋る時、先頭へ付くスクリプト
//
// これが無いと、ラフウは最初に喋る瞬間まで \1\s[] が発行されず、
// 画像が出てくるのが一拍遅れる。
// 先に両方のサーフィスを確定させておくことで、二人同時に出るようにする。
//
// 「起動初期化スクリプト」は、辞書を読み込んでから最初に出すスクリプト
// （起動／他ゴーストから交代／呼び出された時）の頭に、EX変換の後で付く。
//
// 以前は「起動共通スクリプト表示」として置いていたが、そちらはEX変換の前に
// トークの1行目へくっつくため、EXが \0\s[段階] を読み違えて \0\s[1] に
// 書き換えてしまい、起動直後だけ植物が葉1枚の姿で出ていた。
//==============================================================================
起動初期化スクリプト
{
	"\1\s[10]\0\s[%(植物段階)]"
}


//==============================================================================
// 初回起動
//==============================================================================
初回起動
{
	//---- 新しく入れた人には引き継ぎのあいさつを出さない
	引き継ぎあいさつ済み = 1

	<<"
	植０：……。
	ラ：おーい。挨拶。
	植：あ、うん。
	：はじめまして。植本です。
	ラ：オレはラフウ。よろしくな。
	植：よろしく。
	ラ：こいつ無口だけど、悪いやつじゃないから。
	植：無口じゃない。喋るのが遅いだけ。
	ラ：それを無口って言うんだよ。
	">>
}

//---- 消滅させられた後に入れ直された時（reference[0]に消滅回数）
Vanish後初回起動
{
	引き継ぎあいさつ済み = 1

	<<"
	植０：……また来た。
	ラ：戻ってきたな。
	植：うん。
	ラ：まあ、いいさ。またやろう。
	">>
}


//==============================================================================
// 作者の引き継ぎのあいさつ（前から使っている人に、一度だけ）
//
// あやりりすは「起動カスタム」と「起動朝」などの時間帯別を同じ候補に混ぜて
// ランダムに選ぶ（カスタムが優先されるわけではない）。
// そこで、あいさつが残っている間は時間帯別と「起動」を空にして、
// 候補が「起動カスタム」だけになるようにしている。
//
// 待ちかどうかは辞書を読み込んだ時に一度だけ決める。あいさつの中で
// 済みの印を立てても、同じ起動のうちは時間帯別が空のままになるようにするため。
// 新しく入れた人は 初回起動 で済みの印が立つので、あいさつは出ない。
//==============================================================================
ゴースト起動前の処理_引き継ぎあいさつ : void
{
	引き継ぎあいさつ中 = 0
	if !ISVAR('引き継ぎあいさつ済み') {
		引き継ぎあいさつ中 = 1
	}
}

起動カスタム
{
	if !引き継ぎあいさつ中 || ISVAR('引き継ぎあいさつ済み') {
		return
	}
	引き継ぎあいさつ済み = 1

	<<"
	植：（ユーザー）、お知らせ。
	ラ：オレたちを作ってる人が、変わったんだ。
	植：前の人は、月見里さん。
	：ここまで、育ててくれた。
	ラ：これからは、伺々さんが面倒を見てくれる。
	植：ウエモトたちは、このまま。
	ラ：ってわけで、これからもよろしくな。
	">>
}


//==============================================================================
// 起動
// 「起動朝」のような時間帯別があればそちらが優先され、
// 無ければこの「起動」が使われる。
// 先頭の 引き継ぎあいさつ中 の行は、上の引き継ぎのあいさつのためのもの。
//==============================================================================
起動
{
	if 引き継ぎあいさつ中 {
		return
	}

	<<"
	植：（あ｜ん）、（ユーザー）。
	ラ：よお。
	植：おかえり。
	">>

	<<"
	ラ：来たな。
	植：うん、来た。
	ラ：待ってたんだよ、こいつ。
	植：待ってない。
	">>
}

起動朝
{
	if 引き継ぎあいさつ中 {
		return
	}

	<<"
	植：おはよう、（ユーザー）。
	ラ：はやいな。
	植：朝は、水をやる時間だから。
	ラ：お前が水やられる側だろ。
	">>

	<<"
	ラ：おはよう。
	植：……おは（よう｜よ）。
	ラ：まだ寝てるな、これ。
	">>
}

起動昼
{
	if 引き継ぎあいさつ中 {
		return
	}

	<<"
	植：こんにちは。
	ラ：昼か。いい天気だな。
	植：日に当たると、伸びる気がする。
	">>
}

起動夕方
{
	if 引き継ぎあいさつ中 {
		return
	}

	<<"
	植：あ、（ユーザー）。
	ラ：夕方だな。
	植：この時間の光、好き。
	ラ：わかる。
	">>
}

起動夜
{
	if 引き継ぎあいさつ中 {
		return
	}

	<<"
	植：こんばんは。
	ラ：おつかれさん。
	植：今日はもう、のんびりしよう。
	">>
}

起動深夜
{
	if 引き継ぎあいさつ中 {
		return
	}

	<<"
	植：……こんな時間。
	ラ：寝ないのか（ユーザー）。
	植：夜更かしすると、葉っぱに悪い。
	ラ：それお前の話だろ。
	">>
}

//------------------------------------------------------------------------------
// 行事（正月 1/1〜3、クリスマス 12/24〜25、年末 12/26〜31）
// 時間帯別の起動トークと一緒に候補に入り、どちらかが選ばれる。
//------------------------------------------------------------------------------
起動正月
{
	if 引き継ぎあいさつ中 {
		return
	}

	<<"
	植：（ユーザー）、あけましておめでとう。
	ラ：今年もよろしくな。
	植：今年も、のんびり育つ。
	">>
}

起動クリスマス
{
	if 引き継ぎあいさつ中 {
		return
	}

	<<"
	ラ：おっ、来たか。
	植：メリークリスマス、（ユーザー）。
	ラ：今日くらいは、ゆっくりしていけよ。
	">>
}

起動年末
{
	if 引き継ぎあいさつ中 {
		return
	}

	<<"
	植：（ユーザー）、今年もおつかれさま。
	ラ：あと少しだな。
	植：ゆっくり、年を越そう。
	">>
}

//------------------------------------------------------------------------------
// ユーザーの誕生日
//
// SSPの設定でユーザーの誕生日が登録されていると、その日だけ
// 「ユーザー誕生日」スロットが有効になり、この関数が優先される。
// 未登録なら一生呼ばれないので、消しても支障はない。
//------------------------------------------------------------------------------
起動ユーザー誕生日
{
	<<"
	植：（ユーザー）。
	ラ：今日、誕生日だろ。
	植：おめでとう。
	：……なにも用意してないけど。
	ラ：気持ちはあるってさ。
	植：気持ちは、いっぱいある。
	">>
}


//==============================================================================
// 終了
//==============================================================================
終了
{
	<<"
	植：（行っちゃう｜もう行くの）？
	ラ：またな、（ユーザー）。
	植：またね。
	">>

	<<"
	ラ：おう、じゃあな。
	植：……ばいばい。
	">>
}

終了朝
{
	<<"
	植：いってらっしゃい。
	ラ：気をつけてな。
	植：うん、気をつけて。
	">>
}

終了夜
{
	<<"
	植：おやすみ、（ユーザー）。
	ラ：ゆっくり寝ろよ。
	植：ウエモトも、そろそろ閉じる。
	ラ：花じゃないんだから。
	">>
}

終了深夜
{
	<<"
	ラ：やっと寝るのか。
	植：おやすみなさい。
	：ちゃんと寝てね。
	">>
}


//==============================================================================
// 他のゴーストとの交代・呼び出し
//
// 関数名は「ゴースト名＋へ変更」などで、相手ごとに書き分けられる。
// 個別の関数が無い相手には「その他～」が使われる。
//   その他へ変更           … こちらが去って、別のゴーストに交代する時
//   その他から変更         … 別のゴーストから交代して、こちらが出てきた時
//   その他を呼び出し       … こちらが別のゴーストを呼び出す時
//   その他から呼び出される … 別のゴーストに呼び出されて、こちらが出てきた時
// 呼び出しの2つが無いと、あやりりすは何も喋らない
// （「呼び出し反応に切り替え反応を流用」は、設定が無い時は 0 として動く）。
//==============================================================================
その他へ変更
{
	<<"
	植：交代？
	ラ：ちょっと休憩だな。
	植：また呼んでね、（ユーザー）。
	">>
}

その他から変更
{
	<<"
	植：……交代した。
	ラ：よお、（ユーザー）。ここからはオレたちだ。
	">>
}

その他を呼び出し
{
	<<"
	ラ：誰か呼ぶのか。
	植：にぎやかになる。
	">>
}

その他から呼び出される
{
	<<"
	植：呼ばれた。
	ラ：おじゃまするぞ。
	">>
}


//==============================================================================
// 最小化からの復帰
//==============================================================================
OnWindowStateRestore
{
	<<"
	植：（戻ってきた｜おかえり）。
	ラ：しまわれてたな、オレたち。
	">>
}
