//******************************************************************************
// 植本とラフウ
// RSS購読辞書
//
// SSPの \![execute,http-get] でフィードを取り、新着があれば喋る。
// 外部SAORIは不要。フィードの一覧は rss_data.dic にある。
//
// ■流れ
//   OnMinuteChangeAYALILITH（毎分）
//     → 一定間隔ごとに RSS取得実行
//       → \![execute,http-get,...,--async=RSS取得完了,--file=...]
//         → OnExecuteHTTPComplete
//           → RSS取得完了（var フォルダの保存ファイルを読んで解析）
//
// ■サーバーへの配慮
//   購読が複数あっても、1回の取得で1つだけ順番に見に行く。
//   取得間隔は RSS取得間隔分 で変えられる。
//******************************************************************************

//==============================================================================
// 設定
//==============================================================================

//---- 何分おきに1件取りに行くか
//     1件ずつ順番に見て回るので、一周にかかる時間は「購読件数 × この値」。
//     気象庁の高頻度フィードは直近10分程度しか載らないため、
//     防災を購読するなら 1 のままにして、購読件数も絞ること。
RSS取得間隔分
{
	1
}

//---- 防災フィードを通常フィードの何倍の頻度で見に行くか
RSS優先倍率
{
	3
}

//---- ダウンロード先の一時ファイル名（ghost/master/var/ に保存される）
RSS一時ファイル名
{
	'rss_temp.xml'
}

//---- 読み上げるタイトルの最大文字数（超えたら省略する）
RSSタイトル上限
{
	60
}

//---- 1回の解析で読み取る記事の最大件数（新着が何件増えたかを数えるのに使う）
RSS解析件数上限
{
	20
}

//---- ランダムトークに混ぜる話題の数
//     大きくすると植物園の話ばかりになるので控えめに。0で混ぜない。
RSS話題混入数
{
	2
}


//==============================================================================
// 購読リストの管理
//==============================================================================

//---- 現在の購読URL一覧（未設定なら全国まとめだけ）
RSS購読リスト
{
	if !ISVAR('RSS購読') {
		RSS購読 = (IARRAY, RSS全国フィード)
	}

	RSS購読
}

//---- 購読しているか（1/0）
RSS購読中か
{
	ASEARCH(_argv[0], RSS購読リスト) >= 0
}

//---- メニュー表示用のチェックマーク
RSS印
{
	if RSS購読中か(_argv[0]) {
		'■'
	}
	else {
		'□'
	}
}

//---- 購読を切り替える
RSS購読切替 : void
{
	_url  = _argv[0]
	_list = RSS購読リスト
	_i    = ASEARCH(_url, _list)

	if _i >= 0 {
		_list[_i] = IARRAY
		RSS購読 = _list
	}
	else {
		RSS購読 = (_list, _url)
	}
}

//---- URLから表示名を引く
RSS表示名
{
	_url = _argv[0]

	if _url == RSS全国フィード {
		'全国まとめ'
		return
	}

	foreach RSS外部フィード ; _e {
		if _e[2,'|'] == _url {
			_e[1,'|']
			return
		}
	}
	foreach RSS都道府県カタログ ; _e {
		if _e[2,'|'] == _url {
			_e[1,'|']
			return
		}
	}
	foreach RSS施設カタログ ; _e {
		if _e[2,'|'] == _url {
			_e[1,'|']
			return
		}
	}
	foreach RSS防災カタログ ; _e {
		if _e[2,'|'] == _url {
			_e[1,'|']
			return
		}
	}
	foreach RSS報道カタログ ; _e {
		if _e[2,'|'] == _url {
			_e[1,'|']
			return
		}
	}
	foreach RSSメディアカタログ ; _e {
		if _e[2,'|'] == _url {
			_e[1,'|']
			return
		}
	}

	_url
}

//------------------------------------------------------------------------------
// 優先取得の対象か（防災カタログに載っているもの）
//
// 気象庁の高頻度フィードは直近10分程度しか掲載されない。
// 巡回が一周するのを待っていると取りこぼすので、優先して見に行く。
//------------------------------------------------------------------------------
RSS優先か
{
	foreach RSS防災カタログ ; _e {
		if _e[2,'|'] == _argv[0] {
			1
			return
		}
	}

	0
}

//---- 購読中の優先フィード数・通常フィード数
RSS優先件数
{
	_c = 0
	foreach RSS購読リスト ; _u {
		if RSS優先か(_u) {
			_c++
		}
	}
	_c
}

RSS通常件数
{
	ARRAYSIZE(RSS購読リスト) - RSS優先件数
}


//==============================================================================
// 既読管理（フィードごとに最後に読んだ記事のURLを覚えておく）
//==============================================================================
RSS既読取得
{
	if !ISVAR('RSS既読URL') {
		''
		return
	}

	_i = ASEARCH(_argv[0], RSS既読URL)
	if _i < 0 {
		''
		return
	}

	RSS既読リンク[_i]
}

//---- フィードごとの「いちばん新しい記事」を覚えておく
//     ランダムトークで話題にするので、リンクだけでなく題名も持つ
RSS既読記録 : void
{
	if !ISVAR('RSS既読URL') {
		RSS既読URL   = IARRAY
		RSS既読リンク = IARRAY
		RSS既読題名   = IARRAY
	}
	//---- 題名を持たせる前の版から引き継いだ時の補正
	if ARRAYSIZE(RSS既読題名) < ARRAYSIZE(RSS既読URL) {
		RSS既読題名 = IARRAY
		foreach RSS既読URL ; _dummy {
			RSS既読題名 ,= ''
		}
	}

	_i = ASEARCH(_argv[0], RSS既読URL)
	if _i >= 0 {
		RSS既読リンク[_i] = _argv[1]
		RSS既読題名[_i]   = _argv[2]
	}
	else {
		RSS既読URL   = (RSS既読URL, _argv[0])
		RSS既読リンク = (RSS既読リンク, _argv[1])
		RSS既読題名   = (RSS既読題名, _argv[2])
	}
}


//==============================================================================
// 取得
//==============================================================================

//------------------------------------------------------------------------------
// あやりりすが毎分呼ぶフック（他に何も喋ることが無かった時だけ来る）
//------------------------------------------------------------------------------
OnMinuteChangeAYALILITH
{
	//---- 喋っている最中で後回しにした新着があれば、先にそれを片付ける
	if ISVAR('RSS待機題名') {
		if STRLEN(RSS待機題名) {
			_u = RSS待機元
			_t = RSS待機題名
			_l = RSS待機リンク
			_c = RSS待機件数
			RSS待機題名 = ''
			RSS新着を喋る(_u, _t, _l, _c)
			return
		}
	}

	if !ISVAR('RSS次回取得') {
		//---- 起動直後は少し待ってから最初の取得を行う
		RSS次回取得 = 3
	}

	RSS次回取得 = TOINT(RSS次回取得) - 1
	if TOINT(RSS次回取得) > 0 {
		return
	}

	RSS次回取得 = TOINT(RSS取得間隔分)
	RSS取得実行
}

//------------------------------------------------------------------------------
// 購読リストから1件だけ取りに行く（呼ぶたびに次のフィードへ進む）
//------------------------------------------------------------------------------
RSS取得実行
{
	_list = RSS購読リスト
	if ARRAYSIZE(_list) <= 0 {
		return
	}

	//---- 優先（防災）と通常に振り分ける
	_pri = IARRAY
	_nor = IARRAY
	foreach _list ; _u {
		if RSS優先か(_u) {
			_pri ,= _u
		}
		else {
			_nor ,= _u
		}
	}

	//---- どちらのリングから取るか決める
	//     (優先倍率+1)回のうち優先倍率回ぶんを防災にまわす
	_usepri = 0
	if ARRAYSIZE(_pri) > 0 {
		if ARRAYSIZE(_nor) == 0 {
			_usepri = 1
		}
		else {
			_c = 0
			if ISVAR('RSS配分カウンタ') {
				_c = TOINT(RSS配分カウンタ)
			}
			RSS配分カウンタ = _c + 1
			if (_c % (TOINT(RSS優先倍率) + 1)) != TOINT(RSS優先倍率) {
				_usepri = 1
			}
		}
	}

	if _usepri {
		_n = ARRAYSIZE(_pri)
		_i = 0
		if ISVAR('RSS優先位置') {
			_i = TOINT(RSS優先位置)
		}
		if _i >= _n {
			_i = 0
		}
		RSS優先位置  = _i + 1
		RSS取得中URL = _pri[_i]
	}
	else {
		_n = ARRAYSIZE(_nor)
		if _n <= 0 {
			return
		}
		_i = 0
		if ISVAR('RSS巡回位置') {
			_i = TOINT(RSS巡回位置)
		}
		if _i >= _n {
			_i = 0
		}
		RSS巡回位置  = _i + 1
		RSS取得中URL = _nor[_i]
	}

	//---- \C を付けて、今出ているトークを消さないようにする
	"\C\![execute,http-get,%(RSS取得中URL),--async=RSS取得完了,--file=%(RSS一時ファイル名),--timeout=30]\e"
}

//------------------------------------------------------------------------------
// SSPからの取得完了・失敗通知
//------------------------------------------------------------------------------
OnExecuteHTTPComplete
{
	//---- reference[1] に --async= で指定した関数名が入る
	_id = reference[1]
	if ISFUNC(_id) {
		EVAL(_id)
	}
}

OnExecuteHTTPFailure : void
{
	//---- 繋がらないことは普通にあるので、黙って諦める
}


//==============================================================================
// 解析と発言
//==============================================================================

//------------------------------------------------------------------------------
// 相対パスのリンクを絶対URLに直す
//   _argv[0] フィードのURL / _argv[1] 記事のリンク
//------------------------------------------------------------------------------
RSS絶対URL
{
	_l = CUTSPACE(_argv[1])
	if STRLEN(_l) == 0 {
		''
		return
	}
	if RE_SEARCH(_l, '^https?://') >= 0 {
		_l
		return
	}

	if RE_SEARCH(_argv[0], '^(https?://[^/]+)') >= 0 {
		_org = RE_GETSTR[1]
		if SUBSTR(_l, 0, 1) == '/' {
			_org + _l
			return
		}
		_org + '/' + _l
		return
	}

	_l
}

//------------------------------------------------------------------------------
// 記事を先頭から順に取り出して RSS解析タイトル / RSS解析リンク に入れる
//
// RSS2.0は<item>、RSS1.0(RDF)は<item rdf:about="...">と属性が付くので、
// どちらでも拾えるように <item[^>]*> としている。
//------------------------------------------------------------------------------
RSS記事を解析 : void
{
	RSS解析タイトル = IARRAY
	RSS解析リンク   = IARRAY

	_rest = _argv[0]
	_max  = TOINT(RSS解析件数上限)

	_opt = RE_OPTION()
	RE_OPTION('ms')

	//---- RSS(1.0/2.0)は<item>、Atomは<entry>。気象庁はAtomなので両方に対応する。
	_tag = 'item'
	if RE_SEARCH(_rest, '<item[^>]*>') < 0 {
		if RE_SEARCH(_rest, '<entry[^>]*>') >= 0 {
			_tag = 'entry'
		}
	}
	_pat = '<' + _tag + '[^>]*>(.*?)</' + _tag + '>'

	_n = 0
	_scan = 0
	while _n < _max {
		//---- タイトルが空の記事が続くと _n が増えないので、
		//     走査回数そのものにも上限を設けて無限ループを防ぐ
		_scan++
		if _scan > 200 {
			break
		}

		if RE_SEARCH(_rest, _pat) < 0 {
			break
		}

		_item = RE_GETSTR[1]
		_pos  = RE_GETPOS[0]
		_len  = RE_GETLEN[0]

		//---- 読み終わった分を捨てて次の記事へ進む。
		//     ここで確実に縮まないと同じ記事を延々と拾い続けてしまう。
		_cut = TOINT(_pos) + TOINT(_len)
		if _cut <= 0 {
			break
		}
		_rest = ERASE(_rest, 0, _cut)

		//---- 本文の取り出し
		//     Atomは<title>が定型文で<content>に中身が入ることがある
		//     （気象庁は title=「震源・震度に関する情報」/ content=実際の内容）。
		//     [^:>] にしているのは content:encoded を拾わないため。
		_title = ''
		if RE_SEARCH(_item, '<content[^:>]*>(.*?)</content>') >= 0 {
			_title = RE_GETSTR[1]
		}
		if STRLEN(CUTSPACE(_title)) == 0 {
			if RE_SEARCH(_item, '<summary[^:>]*>(.*?)</summary>') >= 0 {
				_title = RE_GETSTR[1]
			}
		}
		if STRLEN(CUTSPACE(_title)) == 0 {
			if RE_SEARCH(_item, '<title[^>]*>(.*?)</title>') >= 0 {
				_title = RE_GETSTR[1]
			}
		}

		//---- リンクの取り出し
		//     Atomは <link href="..."/> と属性に入る。RSSは要素の中身。
		_link = ''
		if RE_SEARCH(_item, '<link[^>]*href="([^"]*)"') >= 0 {
			_link = RE_GETSTR[1]
		}
		if STRLEN(CUTSPACE(_link)) == 0 {
			if RE_SEARCH(_item, '<link[^>]*>(.*?)</link>') >= 0 {
				_link = RE_GETSTR[1]
			}
		}
		if STRLEN(CUTSPACE(_link)) == 0 {
			if RE_SEARCH(_item, '<id[^>]*>(.*?)</id>') >= 0 {
				_link = RE_GETSTR[1]
			}
		}

		_title = RSSテキスト整形(_title)
		//---- 消防庁のように相対パスで書いてあるフィードがあるので絶対URLに直す
		_link  = RSS絶対URL(_argv[1], _link)

		if STRLEN(_title) {
			RSS解析タイトル ,= _title
			//---- linkが無いフィードもあるので、その時はタイトルを目印に使う
			if STRLEN(_link) {
				RSS解析リンク ,= _link
			}
			else {
				RSS解析リンク ,= _title
			}
			_n++
		}
	}

	RE_OPTION(_opt)
}

//------------------------------------------------------------------------------
// 保存されたXMLを読んで、新着があれば知らせる
//------------------------------------------------------------------------------
RSS取得完了
{
	if !ISVAR('RSS取得中URL') {
		return
	}
	_url = RSS取得中URL

	//---- var フォルダの保存ファイルを丸ごと読む
	_path = GETSETTING('coreinfo.path') + 'var/' + RSS一時ファイル名
	if !FOPEN(_path, 'r') {
		return
	}

	//---- 1行ずつ読む。FREADは読み取り失敗時に空文字を返すので、
	//     型判定だけだと抜けられなくなる。行数にも上限を設けておく。
	//     （記事は先頭に並んでいるので、途中で打ち切っても実害は無い）
	_all = ''
	_lines = 0
	while 1 {
		_lines++
		if _lines > 9000 {
			break
		}
		_line = FREAD(_path)
		//---- 終端では整数の -1 が返る（文字列の"-1"と区別するため型で見る）
		if GETTYPE(_line) == 1 {
			break
		}
		_all += _line + CHR(10)
	}
	//---- 戻り値（1）がそのままトークとして出てしまうので void で捨てる
	//     （新着が無くて下で return した時に、吹き出しに「1」と出ていた）
	void FCLOSE(_path)

	//---- 使い終わった一時ファイルは残さない
	void FDEL(_path)

	if STRLEN(_all) == 0 {
		return
	}

	RSS記事を解析(_all, _url)
	_n = ARRAYSIZE(RSS解析タイトル)
	if _n == 0 {
		return
	}

	_top  = RSS解析リンク[0]
	_last = RSS既読取得(_url)

	//---- 前回読んだ記事が今回の何番目にあるかで、増えた件数が分かる
	_new = _n
	if STRLEN(_last) {
		_i = ASEARCH(_last, RSS解析リンク)
		if _i >= 0 {
			_new = _i
		}
	}
	else {
		//---- 購読した直後は、過去の記事を一気に読み上げても仕方がないので1件だけ
		_new = 1
	}

	RSS既読記録(_url, _top, RSS解析タイトル[0])

	if _new <= 0 {
		return
	}

	//---- 喋っている最中に割り込むと会話が途切れるので、その時は後回しにする
	if 'talking' _in_ status {
		RSS待機元     = _url
		RSS待機題名   = RSS解析タイトル[0]
		RSS待機リンク = _top
		RSS待機件数   = _new
		return
	}

	RSS新着を喋る(_url, RSS解析タイトル[0], _top, _new)
}

//------------------------------------------------------------------------------
// XMLのテキストを人が読める形に直す
//------------------------------------------------------------------------------
RSSテキスト整形
{
	_t = _argv[0]

	//---- CDATAの囲みを外す
	_t = REPLACE(_t, '<![CDATA[', '')
	_t = REPLACE(_t, ']]>', '')

	//---- 実体参照を戻す（&amp;は最後に）
	_t = REPLACE(_t, '&lt;',   '<')
	_t = REPLACE(_t, '&gt;',   '>')
	_t = REPLACE(_t, '&quot;', CHR(0x22))
	_t = REPLACE(_t, '&apos;', CHR(0x27))
	_t = REPLACE(_t, '&#39;',  CHR(0x27))
	_t = REPLACE(_t, '&nbsp;', ' ')
	_t = REPLACE(_t, '&amp;',  '&')

	//---- descriptionにHTMLが混ざっている場合に備えてタグを落とす
	_t = RE_REPLACE(_t, '<[^>]*>', '')

	//---- 改行とタブを空白に潰す
	_t = REPLACE(_t, CHR(13), ' ')
	_t = REPLACE(_t, CHR(10), ' ')
	_t = REPLACE(_t, CHR(9),  ' ')
	_t = RE_REPLACE(_t, '  +', ' ')

	_t = CUTSPACE(_t)

	//---- 長すぎる時は切る
	_max = TOINT(RSSタイトル上限)
	if STRLEN(_t) > _max {
		_t = SUBSTR(_t, 0, _max) + '…'
	}

	_t
}

//------------------------------------------------------------------------------
// 新着を読み上げる
//   _argv[0] 元のフィードURL / _argv[1] タイトル / _argv[2] 記事URL / _argv[3] 新着件数
//
// 外部から来た文字列をそのまま流すと、中の \ がさくらスクリプトとして
// 解釈されてしまうので、必ず無効化してから埋め込む。
// EX記法を使わず1行のさくらスクリプトで組み立てているのも同じ理由
// （タイトルに「」や：が入っていても壊れないようにするため）。
//------------------------------------------------------------------------------
RSS新着を喋る
{
	_url   = _argv[0]
	_t     = さくらスクリプト無効化(_argv[1])
	_link  = _argv[2]
	_count = TOINT(_argv[3])

	//---- タイトルをアンカーにして、クリックで記事を開けるようにする
	//     （あやりりすが http(s) のアンカーをブラウザに流してくれる）
	_body = _t
	if RE_SEARCH(_link, '^https?://') >= 0 {
		_body = '\_a[' + _link + ']' + _t + '\_a'
	}

	_s = "\0\s[%(植物段階)]『" + _body + "』\w5こんなのがあるんだね。\w9\w9\1\s[10]だな。"

	//---- どのフィードの話か分からなくなるので、複数購読している時だけ出典を添える
	if ARRAYSIZE(RSS購読リスト) >= 2 {
		_s += "\w9\w9\0\n\n[half]%(RSS表示名(_url))のお知らせ。"
	}

	//---- まとめて増えていた時は件数も知らせる
	if _count >= 2 {
		_s += "\w9\w9\1\n\n[half]ほかにも%(_count - 1)件、\w5新しいのが出てるぞ。"
	}

	_s + '\e'
}


//==============================================================================
// ランダムトークに混ぜる
//
// 購読している各フィードの「いちばん新しい記事」を、普段の雑談に混ぜる。
// 新着があった時だけ喋る上の仕組みと違い、こちらは何度でも話題にする。
//
// ■ % を逃がしている理由
//   ランダムトークの候補は、あやりりすの DelayedTalkEval が
//   "候補" という形に囲み直して EVAL する（%() を後からまとめて展開する高速化）。
//   そのため記事タイトルやURLに % が入っていると変数展開として食われてしまう。
//   URLはパーセントエンコードで % を含むことが普通にあるので、必ず逃がすこと。
//==============================================================================

//---- あやりりすが毎回評価してくれるので、中身が動的でも問題ない
ランダムトークカスタム : array
{
	RSS話題を作る
}

//------------------------------------------------------------------------------
// 購読フィードの中からいくつか選んで、話題の文字列を作る
//------------------------------------------------------------------------------
RSS話題を作る
{
	if !ISVAR('RSS既読URL') {
		IARRAY
		return
	}

	_n = ARRAYSIZE(RSS既読URL)
	if _n == 0 {
		IARRAY
		return
	}

	_max = TOINT(RSS話題混入数)
	if _max <= 0 {
		IARRAY
		return
	}
	if _max > _n {
		_max = _n
	}

	_out   = IARRAY
	_used  = IARRAY
	_guard = 0

	while ARRAYSIZE(_out) < _max {
		_guard++
		if _guard > 50 {
			break
		}

		_i = RAND(_n)
		if ASEARCH(_i, _used) >= 0 {
			continue
		}
		_used ,= _i

		//---- まだ一度も取得できていないフィードは飛ばす
		if STRLEN(RSS既読題名[_i]) == 0 {
			continue
		}

		//---- ランダムトークの候補は後で再EVALされるので、ここで % を逃がす
		_out ,= REPLACE(RSS話題1件(RSS既読URL[_i], RSS既読題名[_i], RSS既読リンク[_i]), '%', '%(CHR(0x25))')
	}

	_out
}

//---- 一度に読み上げる最大件数
RSS一覧上限
{
	30
}

//------------------------------------------------------------------------------
// 覚えている記事を全部並べて読み上げる
//
// メニューの「お知らせ聞かせて」用。
// こちらは再EVALされない経路なので % は逃がさない。
//------------------------------------------------------------------------------
RSS話題をすべて
{
	if !ISVAR('RSS既読URL') {
		''
		return
	}

	//---- 中身のあるフィードだけを対象にする
	_idx = IARRAY
	_n = ARRAYSIZE(RSS既読URL)
	for _i = 0; _i < _n; _i++ {
		if STRLEN(RSS既読題名[_i]) {
			_idx ,= _i
		}
	}

	_c = ARRAYSIZE(_idx)
	if _c == 0 {
		''
		return
	}

	_max = TOINT(RSS一覧上限)
	_over = 0
	if _c > _max {
		_over = _c - _max
		_c = _max
	}

	//---- 読む時間を確保する。
	//     何も指定しないと _config.dic の自動クローズ（5秒）で途中で閉じてしまう。
	//     スクリプト内に balloontimeout があれば、あちらは手を出さない作りにしてある。
	_wait = 8000 + (_c * 4000)
	if _wait > 180000 {
		_wait = 180000
	}

	_s  = '\![set,balloontimeout,' + _wait + ']'
	_s += '\0\s[' + 植物段階 + ']今あるのは、ぜんぶで' + _c + '件。\w9\n\n'

	_k = 0
	foreach _idx ; _i {
		if _k >= _max {
			break
		}
		_k++

		_t = さくらスクリプト無効化(RSS既読題名[_i])
		_l = RSS既読リンク[_i]

		_body = _t
		if RE_SEARCH(_l, '^https?://') >= 0 {
			_body = '\_a[' + _l + ']' + _t + '\_a'
		}

		_s += '・' + _body + '\n'
		_s += '　　' + RSS表示名(RSS既読URL[_i]) + '\n'
	}

	if _over > 0 {
		_s += '\nほかに' + _over + '件あるけど、長いから省いた。\n'
	}

	_s += '\n\1\s[10]以上だ。\e'

	_s
}

//------------------------------------------------------------------------------
// 話題1件ぶんの文字列を組み立てる（%() を使わず連結だけで作る）
//------------------------------------------------------------------------------
RSS話題1件
{
	_url = _argv[0]
	_t   = さくらスクリプト無効化(_argv[1])
	_l   = _argv[2]

	//---- タイトルを押すと記事が開くように
	_body = _t
	if RE_SEARCH(_l, '^https?://') >= 0 {
		_body = '\_a[' + _l + ']' + _t + '\_a'
	}

	_s  = '\0\s[' + 植物段階 + ']『' + _body + '』\w5こんなのがあるんだね。'
	_s += '\w9\w9\1\s[10]だな。'

	if ARRAYSIZE(RSS購読リスト) >= 2 {
		_s += '\w9\w9\0\n\n[half]' + RSS表示名(_url) + 'のお知らせ。'
	}

	_s + '\e'
}
