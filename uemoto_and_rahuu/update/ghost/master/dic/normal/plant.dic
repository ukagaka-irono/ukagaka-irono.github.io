//******************************************************************************
// 植本とラフウ
// 植物成長辞書
//
// 植本のサーフィス0〜6は表情ではなく、頭に生えている植物の育ち具合。
//   0 : まだ何も生えていない
//   1 : 葉が1枚
//   2 : 葉が2枚
//   3 : 葉が3枚
//   4 : 葉が4枚
//   5 : つぼみ
//   6 : 花
//
// 累積起動時間に応じて段階が上がり、花が咲いてしばらく経つと散って
// 段階0に戻る。この繰り返しを「周回」と呼ぶ。
// 周回数は「どれだけ長く付き合ってきたか」の指標になり、
// トークの出し分けにも使っている。
//
// 状態はすべて累積起動時間から計算しているので、
// セーブデータがずれても自動的に正しい段階に戻る。
//******************************************************************************

//==============================================================================
// 成長パラメータ
//==============================================================================

//---- 1周にかかる累積起動時間（時間）
// しきい値の最大（=花が咲く時間）より大きくすること。
// 差の分だけ花が咲いたままになる。今は 48-36=12時間 花が保つ。
植物周回長
{
	48
}

//---- 各段階に到達するのに必要な「周内の」累積起動時間（時間）
// ここを書き換えれば成長ペースを変えられる。
植物成長しきい値 : array
{
	0	// 段階0 まだ何も
	1	// 段階1 葉1枚
	3	// 段階2 葉2枚
	6	// 段階3 葉3枚
	12	// 段階4 葉4枚
	24	// 段階5 つぼみ
	36	// 段階6 花
}


//---- 水やり1回でどれだけ成長が進むか（時間）
水やりボーナス時間
{
	2
}


//==============================================================================
// 現在の状態
//==============================================================================

//------------------------------------------------------------------------------
// 成長の基準になる時間
//
// 累積起動時間そのものではなく、水やりで貯めたボーナスを足した値を使う。
// 「一緒にいた時間」＋「世話をした分」で育つ、という考え方。
//------------------------------------------------------------------------------
植物成長時間
{
	_b = 0
	if ISVAR('植物ボーナス') {
		_b = TOINT(植物ボーナス)
	}
	_v = TOINT(累積起動時間) + _b

	//---- 累積起動時間は shiori3.dic の unload でしか確定保存されない。
	//     SSPが異常終了するとその回の分が丸ごと失われ、次の起動で値が巻き戻る。
	//     そのまま使うと植物が縮んで見えてしまうので、
	//     これまでの最大値を覚えておいて後戻りさせない。
	if !ISVAR('植物成長時間最大') {
		植物成長時間最大 = _v
	}
	if _v > TOINT(植物成長時間最大) {
		植物成長時間最大 = _v
	}

	TOINT(植物成長時間最大)
}

//---- 何周目か（0 = 1周目、まだ一度も咲いていない）
植物周回数
{
	_h = TOINT(植物成長時間)
	_len = TOINT(植物周回長)
	_h / _len
}

//---- 今の周に入ってから何時間ぶん育ったか
植物周内時間
{
	_h = TOINT(植物成長時間)
	_len = TOINT(植物周回長)
	_h % _len
}

//---- 現在の植物段階（0〜6）
植物段階
{
	_h = TOINT(植物周内時間)
	_th = 植物成長しきい値

	_stage = 0
	for _i = 0; _i < ARRAYSIZE(_th); _i++ {
		if _h >= TOINT(_th[_i]) {
			_stage = _i
		}
	}

	_stage
}

//---- 段階の呼び名（トーク内で %(植物段階名) として使える）
植物段階名
{
	case 植物段階 {
		when 0 { 'まだ何も' }
		when 1 { '葉っぱが一枚' }
		when 2 { '葉っぱが二枚' }
		when 3 { '葉っぱが三枚' }
		when 4 { '葉っぱが四枚' }
		when 5 { 'つぼみ' }
		when 6 { '花' }
		others { 'なにか' }
	}
}

//---- 次の変化まであと何時間か（花のあとは「散るまで」を返す）
植物次段階まで
{
	_next = 植物段階 + 1
	_th = 植物成長しきい値

	if _next >= ARRAYSIZE(_th) {
		//---- 花が咲いている間は、散るまでの時間
		TOINT(植物周回長) - TOINT(植物周内時間)
		return
	}

	TOINT(_th[_next]) - TOINT(植物周内時間)
}


//==============================================================================
// 立ち絵の復元
//
// SSPは「表示を既定の姿に戻したい」時に OnSurfaceRestore を送ってくる。
// ここで何も返さないとSSPが自前の既定値（surface0）に戻してしまい、
// 育っているはずの植物が芽なしの姿になってしまう。
//
// shiori3.dic も本体非依存版として OnSHIORI3FW.SurfaceRestore を投げるので、
// 両方に同じ答えを返しておく。
//==============================================================================
立ち絵を戻す
{
	"\0\s[%(植物段階)]\1\s[10]\e"
}

OnSurfaceRestore
{
	立ち絵を戻す
}

OnSHIORI3FW.SurfaceRestore
{
	立ち絵を戻す
}


//==============================================================================
// ランダムトークの条件スロットを追加する
//
// これを定義すると「ランダムトーク花」「ランダムトーク2周目以降」のような
// 関数が書けるようになり、植物の状態に応じたトークが混ざるようになる。
// 起動トーク（起動花 など）にも同じスロットが使える。
// この関数は1つしか置けないので、植物以外のスロットもここに並べる。
//   ベースウェアスロット … talk_baseware.dic
//   咲いている花スロット … flower.dic（咲いている花の名前ごとのトーク）
//==============================================================================
あやりりす・日付イベントユーザー定義 : array
{
	植物状態名
	植物周回名
	ベースウェアスロット
	咲いている花スロット
}

植物状態名
{
	case 植物段階 {
		when 0       { '芽なし' }
		when 1,2,3,4 { '葉' }
		when 5       { 'つぼみ' }
		when 6       { '花' }
		others       { '芽なし' }
	}
}

植物周回名
{
	if 植物周回数 <= 0 {
		'1周目'
	}
	else {
		'2周目以降'
	}
}


//==============================================================================
// 水やり
//
// 1日1回だけ、植物ボーナスに 水やりボーナス時間 を足せる。
// メニューの「水をあげる」から呼ばれる。
//==============================================================================

//---- 日付の識別キー（日をまたいだかの判定に使う）
今日の日付キー
{
	_t = GETTIME
	"%(_t[0])-%(_t[1])-%(_t[2])"
}

//---- 今日はもう水をあげたか（1 = あげた）
水やり済みか
{
	if !ISVAR('最終水やり日') {
		0
		return
	}

	if 最終水やり日 == 今日の日付キー {
		1
	}
	else {
		0
	}
}

//---- 通算の水やり回数
水やり回数取得
{
	if ISVAR('水やり回数') {
		TOINT(水やり回数)
	}
	else {
		0
	}
}

//------------------------------------------------------------------------------
// 水をあげる本体
// 成長段階が上がった時は、その場でちゃんと反応する。
//------------------------------------------------------------------------------
水をあげる
{
	//---- 今日はもうあげている
	if 水やり済みか {
		<<"
		植：今日はもう、もらった。
		ラ：やりすぎもよくないんだろ。
		植：うん。ほどほどが好き。
		">>
		return
	}

	_before    = 植物段階
	_lapbefore = 植物周回数

	//---- 記録を更新
	最終水やり日 = 今日の日付キー

	_b = 0
	if ISVAR('植物ボーナス') {
		_b = TOINT(植物ボーナス)
	}
	植物ボーナス = _b + TOINT(水やりボーナス時間)

	水やり回数 = 水やり回数取得 + 1

	//---- 一周した・花が咲いた時は、そちらのトークを優先する
	_s = お世話のあとの変化(_before, _lapbefore)
	if STRLEN(_s) {
		_s
		return
	}

	//---- 水やりで段階が上がった場合
	if 植物段階 > _before {
		<<"
		植：ん。
		ラ：おい、今ちょっと伸びたぞ。
		植：ほんとだ。
		：水、効くんだ。
		">>
		return
	}

	//---- 通常
	<<"
	植：……ん。ありがとう。
	ラ：うまそうに飲むなあ。
	植：おいしい。
	">>

	<<"
	植：わ、つめたい。
	ラ：じっとしてろって。
	植：うん。
	">>

	<<"
	ラ：ちゃんと根まで届いたか？
	植：たぶん。
	：じんわりくる。
	">>
}


//------------------------------------------------------------------------------
// お世話（水やり・日なた）で植物ボーナスを足した直後の確認
//   _argv[0] … 足す前の段階 / _argv[1] … 足す前の周回
// 一周して散った時と、花が咲いた時は、そのトークを返す。それ以外は空。
// 成長イベント側と二重に喋らないよう、記憶もここで進めておく。
//------------------------------------------------------------------------------
お世話のあとの変化
{
	_before    = TOINT(_argv[0])
	_lapbefore = TOINT(_argv[1])
	_after     = 植物段階
	_lapafter  = 植物周回数

	植物段階記憶 = _after
	植物周回記憶 = _lapafter

	if _lapafter > _lapbefore {
		花が散る
		return
	}

	if _after > _before && _after >= 6 {
		植物が育つ
		return
	}

	''
}


//==============================================================================
// 日なたに出す
//
// 1日1回だけ、植物ボーナスに 日なたボーナス時間 を足せる。
// メニューの「お世話する」→「日なたに出す」から呼ばれる。
// 夜（あやりりすの時間帯が 夜・深夜）は日が出ていないので、断って回数も使わない。
//==============================================================================

//---- 日なた1回でどれだけ成長が進むか（時間）
日なたボーナス時間
{
	1
}

//---- 今日はもう日なたに出したか（1 = 出した）
日なた済みか
{
	if !ISVAR('最終日なた日') {
		0
		return
	}

	if 最終日なた日 == 今日の日付キー {
		1
	}
	else {
		0
	}
}

//---- 通算の日なた回数
日なた回数取得
{
	if ISVAR('日なた回数') {
		TOINT(日なた回数)
	}
	else {
		0
	}
}

日なたに出す
{
	if 日なた済みか {
		<<"
		植：今日はもう、日なたぼっこした。
		ラ：焼けすぎても困るしな。
		植：こんがりは、いや。
		">>
		return
	}

	_slot = GetTimeSlotList
	if _slot == '夜' || _slot == '深夜' {
		<<"
		植：日なた……？
		ラ：もう日が沈んでるぞ。
		植：また明るい時に、おねがい。
		">>
		return
	}

	_before    = 植物段階
	_lapbefore = 植物周回数

	最終日なた日 = 今日の日付キー

	_b = 0
	if ISVAR('植物ボーナス') {
		_b = TOINT(植物ボーナス)
	}
	植物ボーナス = _b + TOINT(日なたボーナス時間)

	日なた回数 = 日なた回数取得 + 1

	_s = お世話のあとの変化(_before, _lapbefore)
	if STRLEN(_s) {
		_s
		return
	}

	if 植物段階 > _before {
		<<"
		植：あ。
		ラ：伸びたな、今。
		植：日なた、効く。
		">>
		return
	}

	case _slot {
		when '朝' {
			<<"
			植：朝の光、やわらかい。
			ラ：寝ぼけた顔がしゃきっとしたな。
			植：起きた。
			">>
		}
		when '夕方' {
			<<"
			植：夕日、あったかい。
			ラ：ぎりぎり間に合ったな。
			植：うん。
			">>
		}
		others {
			<<"
			植：……ぽかぽか。
			ラ：気持ちよさそうだな。
			植：葉っぱが、ひらく。
			">>

			<<"
			ラ：ほら、日なただぞ。
			植：まぶしい。
			：でも、うれしい。
			">>
		}
	}
}


//==============================================================================
// 成長イベント
// 累積起動時間が1時間変わるたびに呼ばれる。変化があった時だけ喋る。
//==============================================================================
累積起動時間変化
{
	_stage = 植物段階
	_lap   = 植物周回数

	//---- 初回は記憶するだけで喋らない
	if !ISVAR('植物段階記憶') {
		植物段階記憶 = _stage
		植物周回記憶 = _lap
		return
	}
	if !ISVAR('植物周回記憶') {
		植物周回記憶 = _lap
	}

	//---- 周回が進んだ＝花が散った（段階は6→0に戻るので先に判定する）
	if _lap > 植物周回記憶 {
		植物周回記憶 = _lap
		植物段階記憶 = _stage
		花が散る
		return
	}

	//---- 段階が上がった
	if _stage > 植物段階記憶 {
		植物段階記憶 = _stage
		植物が育つ
		return
	}

	植物段階記憶 = _stage
}

//------------------------------------------------------------------------------
// 段階が上がった時
//------------------------------------------------------------------------------
植物が育つ
{
	case 植物段階 {
		when 1 {
			if 植物周回数 <= 0 {
				<<"
				ラ：おい植本、頭。
				植：ん？
				ラ：なんか出てる。
				植：……あ。
				：芽が出た。
				">>
				return
			}
			<<"
			植：また出てきた。
			ラ：律儀だなあ、この芽。
			植：うん。まじめ。
			">>
		}
		when 2,3,4 {
			<<"
			植：葉っぱ、増えた。
			ラ：ほんとだ。%(植物段階名)になってる。
			植：伸びるなあ。
			">>
		}
		when 5 {
			<<"
			ラ：植本。
			植：うん。
			ラ：それ、つぼみじゃないか？
			植：……そうかも。
			ラ：咲くのかな。
			植：咲くんじゃない。たぶん。
			">>
		}
		when 6 {
			//---- 咲く花の名前を決めて、その花のトークを出す（flower.dic）
			花が咲いた
		}
	}
}

//------------------------------------------------------------------------------
// 花が散って次の周に入る時
//------------------------------------------------------------------------------
花が散る
{
	if 植物周回数 <= 1 {
		<<"
		植：あ。
		ラ：どうした。
		植：花、散った。
		ラ：……終わり、か。
		植：ううん。
		：また生えてくる。
		ラ：そういうもんか。
		植：そういうもん。
		">>
		return
	}

	<<"
	植：散った。
	ラ：これで%(植物周回数)回目か。
	植：うん。
	：何回でも、咲くよ。
	">>
}
