//******************************************************************************
// 植本とラフウ
// あやりりす／あやりりすEX 設定辞書
//
// ここの設定はすべて ISFUNC でガードされているので、
// 項目ごと削除すればあやりりす側の既定値に戻ります。
//******************************************************************************

//==============================================================================
// キャラクター設定メモ（トークを書き足す時はここに合わせること）
//
//   \0 植本（うえもと） … EXヘッダ「植」
//        一人称：ウエモト  ※カタカナ。「わたし」等は使わない
//        口数が少なく、短い文で喋る。植物寄りの物の見方をする。
//        サーフィスは表情ではなく頭の植物の育ち具合（plant.dic 参照）。
//
//   \1 ラフウ … EXヘッダ「ラ」
//        一人称：オレ  ※カタカナ。「おれ」「俺」は使わない
//        植本より口が回る。突っ込み役。面倒見がいい。
//
//   ＜表記ルール＞
//        一人称だけカタカナ。呼びかけ・地の文は漢字の「植本」を使う。
//          例）ラ：なあ植本。         ← 呼びかけは漢字
//              植：ウエモトは葉っぱ。 ← 一人称はカタカナ
//==============================================================================

//==============================================================================
// あやりりす本体の設定
//==============================================================================

//---- なでなで判定のしきい値（大きいほど鈍い／既定40）
あやりりす・マウスなで感度
{
	40
}

//---- ホイール判定のしきい値（既定4）
あやりりす・マウスホイール感度
{
	4
}

//---- ユーザー名に自動付加される敬称
名前入力敬称
{
	'さん'
}

//---- 名前を教わる前の初期ユーザー名
名前入力初期
{
	'あなた'
}


//==============================================================================
// あやりりすEX（簡易トーク記法）の設定
//==============================================================================

//---- \0（植本）のヘッダ文字
あやりりすEXヘッダ0
{
	'[植う]'
}

//---- \1（ラフウ）のヘッダ文字
あやりりすEXヘッダ1
{
	'[ラら]'
}

//------------------------------------------------------------------------------
// 標準表情
//
// 植本のサーフィスは表情ではなく「頭の植物の育ち具合」なので、
// サーフィス番号を省略した「植：」は現在の育ち具合を自動で出す。
//------------------------------------------------------------------------------
あやりりすEX標準表情0
{
	植物段階
}

あやりりすEX標準表情1
{
	10
}

//---- 上の2つは辞書を読み込んだ時に一度だけ評価され、値が覚えられる。
//     そのままだと、起動している間に植物が育っても「植：」は読み込んだ時の
//     段階のまま出てしまうので、こちらで毎回その場の段階を返す。
//     （定義してあれば、あやりりすEXは標準表情よりこちらを使う）
あやりりすEX拡張標準表情
{
	if TOINT(_argv[0]) == 0 {
		植物段階
	}
	else {
		10
	}
}

//------------------------------------------------------------------------------
// サーフィス番号の自動補正について
//
// あやりりすEXは「あやりりすEXSurfaceTranslate」を定義しておくと、
// 変換の最後にサーフィス番号を書き換える。
// スコープの取り違えを吸収する目的で一度は用意したが、
// 起動時の立ち絵が実際の成長段階とずれる原因と考えて外してある。
//
//   標準表情0 → 3        （正しい）
//   共通スクリプトの返り値 → \0\s[3]  （正しい）
//   EX変換を通過した後   → \0\s[1]    （ここで書き換わっていた）
//
// ※外した後も同じずれが残っていた。本当の原因は、起動共通スクリプトが
//   EX変換の前にトークの1行目へくっつき、EXがその \0\s[3] を読み違えていた
//   こと。今は「起動初期化スクリプト」（EX変換の後に付く）に移してある
//   （talk_boot.dic）。
//
// 定義しなければ番号はそのまま通るので、補正は行われない。
// 植本は 0〜6、ラフウは 10 しか持たないので、辞書を書く時にそこだけ守ること。
// （必要になったら、引数の並びを実測してから作り直すこと）
//------------------------------------------------------------------------------

//---- SakuraScript記法にもウエイトを自動挿入するか（0=しない）
あやりりすEXSakuraScript文ウエイト支援
{
	0
}


//==============================================================================
// しゃべり終わったらバルーンを自動で閉じる
//
// \![set,balloontimeout,ミリ秒] はスクリプトの表示が終わってから数え始める。
// ただし「そのスクリプト1回きり」の設定なので、毎回付ける必要がある。
// そこで OnTranslateInternal（出力直前に必ず通る）で全トークの頭に足す。
//
// 関数名は OnTranslateInternal で始まっていれば何でもよく、
// 名前の昇順に実行される。あやりりすEXの変換（AAA_AYLEX）より後に来るよう
// B で始めてある。
//==============================================================================

//---- バルーンを閉じるまでの時間（ミリ秒）。0にすると閉じなくなる。
バルーン表示時間
{
	5000
}

OnTranslateInternal.BalloonTimeout
{
	_s = _argv[0]

	//---- On_ で始まるものはトークではなくリソース要求（おすすめサイト一覧など）。
	//     タグを足すと中身が壊れるので触らない。
	if SUBSTR(SHIORI3FW.Eventid, 0, 3) == 'On_' {
		_s
		return
	}

	if STRLEN(_s) == 0 {
		_s
		return
	}

	_t = TOINT(バルーン表示時間)
	if _t <= 0 {
		_s
		return
	}

	//---- 選択肢や入力欄が出ている時に閉じると操作できなくなるので、そのままにする
	if '\q[' _in_ _s {
		_s
		return
	}
	if '\![open,inputbox' _in_ _s {
		_s
		return
	}
	if '\![open,communicatebox' _in_ _s {
		_s
		return
	}
	if '\![open,teachbox' _in_ _s {
		_s
		return
	}

	//---- トーク側で個別に指定している場合はそちらを尊重する
	if 'balloontimeout' _in_ _s {
		_s
		return
	}

	"\![set,balloontimeout,%(_t)]" + _s
}


//==============================================================================
// 選択肢を出す時は大きい吹き出しにする
//
// メニューは7行ほどあり、横2列（\_l[145]）に並ぶ項目もあるので、
// 小さい吹き出し（\b[0]）では上が隠れたり右の列が切れたりする。
// 選択肢（\q[）があるスクリプトだけ、頭で植本の吹き出しを \b[2] に替える。
// 専用バルーンはどちらも 2/3 番に大きい吹き出しを持っている
// （ふたばとしょっかく は 0/1 と同じ大きさ、ふたばとあまぐも は 338x214）。
// トーク側で \b[ を指定している時はそちらを尊重する。
//==============================================================================
OnTranslateInternal.BigBalloonForChoice
{
	_s = _argv[0]

	if SUBSTR(SHIORI3FW.Eventid, 0, 3) == 'On_' {
		_s
		return
	}
	if !('\q[' _in_ _s) || ('\b[' _in_ _s) {
		_s
		return
	}

	'\0\b[2]' + _s
}


//==============================================================================
// エラー処理関数
//
// YAYAが限界に達した時に自動で呼ばれる。定義が無いと
// 「必須の関数がありません(E0032)」がログに出る。
// 戻り値は無視される。GETCALLSTACK でどこで起きたか分かる。
//==============================================================================
shiori.OnLoopLimit : void
{
	LOGGING("[LIMIT] ループ回数上限 " + _argv[0] + "(" + _argv[1] + ") stack=" + TOSTR(GETCALLSTACK))
}

shiori.OnCallLimit : void
{
	LOGGING("[LIMIT] 呼び出し深度上限 " + _argv[0] + "(" + _argv[1] + ") stack=" + TOSTR(GETCALLSTACK))
}

shiori.OnMemoryLimit : void
{
	LOGGING("[LIMIT] メモリ上限 stack=" + TOSTR(GETCALLSTACK))
}

shiori.OnMemoryError : void
{
	LOGGING("[LIMIT] メモリエラー stack=" + TOSTR(GETCALLSTACK))
}


//==============================================================================
// 起動時の自己修復
//
// aitalkinterval はグローバル変数なのでセーブファイルに残る。
// 何かの拍子に 0 のまま保存されると、ランダムトークが永久に止まったまま
// 戻らなくなる（本人はメニューで「黙る」を選んだ覚えがないので気づけない）。
// 自分で「黙る」を選んだ時だけ 黙る設定 が立つようにしてあるので、
// フラグが立っていないのに 0 なら事故とみなして既定値へ戻す。
//==============================================================================
ゴースト起動前の処理_トーク間隔の修復 : void
{
	//---- 選択肢の追加引数の受け取り方を間違えていた頃は、
	//     喋る頻度メニューで何を選んでも 0（＝黙る）になってしまっていた。
	//     その環境が「自分で黙らせた」と誤認されないよう、一度だけ解除する。
	if !ISVAR('トーク間隔設定の修正済み') {
		トーク間隔設定の修正済み = 1
		ERASEVAR('黙る設定')
	}

	if !ISVAR('aitalkinterval') {
		return
	}
	if TOINT(aitalkinterval) != 0 {
		return
	}
	if ISVAR('黙る設定') && TOINT(黙る設定) == 1 {
		//---- 自分で黙らせたのなら尊重する
		return
	}

	aitalkinterval = 180
}
