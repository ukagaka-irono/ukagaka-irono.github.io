//******************************************************************************
// 植本とラフウ
// ベースウェア別トーク辞書
//
// 動いているベースウェアに合わせて、ランダムトークと起動トークの候補を足す。
//   ランダムトークベースウェアSSP / 起動ベースウェアSSP … のように書く。
// スロットの登録は plant.dic の「あやりりす・日付イベントユーザー定義」。
//******************************************************************************

//==============================================================================
// ベースウェアの判定
//
// basewarenameex は、システム辞書（yaya_base/shiori3.dic）が最初に受け取った
// リクエストの Sender。起動している間は変わらない。
//   SSP     … 'SSP'
//   MATERIA … 'embryo'
//   CROW    … 'crow'
//   ninix   … 'ninix-kagari' / 'ninix-aya'
// （SSP と ninix は確かめた値。MATERIA と CROW は yaya-docs の表による）
//
// 分からない時に空文字を返すと「ランダムトーク」「起動」そのものが
// 候補に入ってしまうので、使わない名前「ベースウェアその他」を返す。
//==============================================================================
ベースウェアスロット
{
	_b = TOLOWER(basewarenameex)

	if _b == 'ssp' {
		'ベースウェアSSP'
	}
	elseif _b == 'embryo' || _b == 'materia' {
		'ベースウェアMATERIA'
	}
	elseif _b == 'crow' {
		'ベースウェアCROW'
	}
	elseif SUBSTR(_b, 0, 5) == 'ninix' {
		'ベースウェアninix'
	}
	else {
		'ベースウェアその他'
	}
}


//==============================================================================
// ランダムトーク
//==============================================================================
ランダムトークベースウェアSSP : array
{
	<<'
	植：ここ、SSP。
	ラ：オレたちが住んでる場所の名前だな。
	植：住み心地、いい。
	'>>

	<<'
	ラ：SSPって、ずっと手入れされてるらしいぞ。
	植：ウエモトと同じ。
	ラ：お前のは水やりだろ。
	'>>
}

ランダムトークベースウェアCROW : array
{
	<<'
	植：ここ、CROW。
	ラ：カラスって意味だな。
	植：つつかれないか、心配。
	ラ：大丈夫だろ、たぶん。
	'>>
}

ランダムトークベースウェアMATERIA : array
{
	<<'
	ラ：ここ、MATERIAだな。
	植：いちばん古いところ、って聞いた。
	ラ：オレたちだと、うまく動かないところもあるかもな。
	植：古い家も、好き。
	'>>
}

ランダムトークベースウェアninix : array
{
	<<'
	植：ここ、ninix。
	ラ：Windowsじゃないところでも、オレたちが動けるやつだ。
	植：遠くまで来た。
	'>>
}


//==============================================================================
// 起動トーク
// 時間帯別の起動トークと一緒に候補に入り、どちらかが選ばれる。
// 先頭の 引き継ぎあいさつ中 の行は消さない（talk_boot.dic 参照）。
//==============================================================================
起動ベースウェアSSP
{
	if 引き継ぎあいさつ中 {
		return
	}

	<<"
	植：（ユーザー）。SSPで、また会えた。
	ラ：いつもの場所だな。
	">>
}

起動ベースウェアCROW
{
	if 引き継ぎあいさつ中 {
		return
	}

	<<"
	植：……いつもと、ちょっと違う。
	ラ：CROWだからな。
	植：でも、（ユーザー）はいる。
	">>
}

起動ベースウェアMATERIA
{
	if 引き継ぎあいさつ中 {
		return
	}

	<<"
	ラ：おっ、MATERIAか。
	植：なつかしい匂い。
	ラ：お前、初めてだろ。
	">>
}

起動ベースウェアninix
{
	if 引き継ぎあいさつ中 {
		return
	}

	<<"
	植：ninix。
	ラ：遠いところから呼ばれたな。
	植：こんにちは、（ユーザー）。
	">>
}
