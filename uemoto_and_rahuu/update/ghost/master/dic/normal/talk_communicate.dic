//******************************************************************************
// 植本とラフウ
// コミュニケート辞書（話しかけへの反応）
//
// ■書き方
//   ユーザーコミュ<条件>  … ユーザーが入力した文字列に反応する
//   ＊その他コミュ<条件>  … 他のゴーストから話しかけられた時
//
// ■条件の書き方
//   ｜（全角）で区切ると OR。どれか1つ含まれていればマッチ。
//   ＆（全角）で区切ると AND。全部含まれていないとマッチしない。
//   ＆で繋いだ数がそのままスコアになり、スコアが高いものが優先される。
//   （例：「植物＆好き」は「好き」だけの定義より優先して選ばれる）
//   同点の場合はその中からランダムに1つ選ばれる。
//
// ■どれにも当てはまらない時
//   ユーザーコミュ該当なし が呼ばれる。
//******************************************************************************

//==============================================================================
// ユーザーからの話しかけ
//==============================================================================

//------------------------------------------------------------------------------
// あいさつ
//------------------------------------------------------------------------------
ユーザーコミュおはよ
{
	<<"
	植：おはよう。
	ラ：早いな。
	植：今日もよろしく。
	">>
}

ユーザーコミュこんにちは｜こんにちわ
{
	<<"
	植：こんにちは。
	ラ：よお。
	">>
}

ユーザーコミュこんばんは｜こんばんわ
{
	<<"
	植：こんばんは。
	ラ：もう暗いな。
	">>
}

ユーザーコミュおやすみ｜ねむい｜眠い
{
	<<"
	植：おやすみ。
	ラ：ゆっくり寝ろよ。
	植：また明日。
	">>
}

ユーザーコミュただいま｜帰った
{
	<<"
	植：おかえり。
	ラ：おつかれさん。
	植：ゆっくりして。
	">>
}


//------------------------------------------------------------------------------
// 植物まわり（このゴーストの本題）
//------------------------------------------------------------------------------
ユーザーコミュ水
{
	<<"
	植：水？
	ラ：メニューからあげられるぞ。
	植：一日一回だけね。
	">>
}

ユーザーコミュ花
{
	<<"
	植：花は、まだ先かも。
	ラ：気長にな。
	植：うん。急がない。
	">>
}

ユーザーコミュ葉｜植物｜芽
{
	<<"
	植：これ、ウエモトの一部だと思ってる。
	ラ：思ってるだけかよ。
	植：たぶん、そう。
	">>
}

//---- ＆で繋ぐと、単独キーワードより優先される
ユーザーコミュ植物｜花｜葉＆好き｜すき
{
	<<"
	植：……ウエモトも好き。
	ラ：話が合ってよかったな。
	">>
}


//------------------------------------------------------------------------------
// 自分たちのこと
//------------------------------------------------------------------------------
ユーザーコミュウエモト｜植本
{
	<<"
	植：呼んだ？
	ラ：呼ばれてるぞ。
	植：はーい。
	">>
}

ユーザーコミュラフウ
{
	<<"
	ラ：おう、オレか。
	植：ラフウはあったかいよ。
	ラ：それ紹介になってるか？
	">>
}

ユーザーコミュ名前
{
	<<"
	植：名前？
	ラ：メニューから教えてもらえるぞ。
	植：おぼえるから、教えて。
	">>
}

ユーザーコミュ好き｜すき
{
	<<"
	植：……うん。
	：ウエモトも。
	ラ：素直だな今日は。
	">>
}

ユーザーコミュかわいい｜かわいー｜可愛い
{
	<<"
	植：そう？
	ラ：照れてる照れてる。
	植：照れてない。
	">>
}

ユーザーコミュありがと
{
	<<"
	植：どういたしまして。
	ラ：こっちこそな。
	">>
}


//------------------------------------------------------------------------------
// 気づかい
//------------------------------------------------------------------------------
ユーザーコミュ疲れ｜つかれ｜しんどい｜だるい
{
	<<"
	植：無理しないで。
	ラ：休むのも仕事のうちだぞ。
	植：うん。休も。
	">>
}

ユーザーコミュ元気
{
	<<"
	植：元気だよ。
	ラ：こいつは基本ずっとこれだ。
	植：安定してる。
	">>
}

ユーザーコミュ暑｜あつ
{
	<<"
	植：暑いと、水がほしくなる。
	ラ：お前はいつも欲しがってるだろ。
	">>
}

ユーザーコミュ寒｜さむ
{
	<<"
	植：寒いと、縮む。
	ラ：あったかくしとけよ、（ユーザー）。
	">>
}


//------------------------------------------------------------------------------
// 天気
//------------------------------------------------------------------------------
ユーザーコミュ雨
{
	<<"
	植：雨の日は、ちょっとうれしい。
	ラ：お前は水が好きだからな。
	植：（ユーザー）は、濡れないでね。
	">>
}

ユーザーコミュ晴れ｜はれ｜いい天気
{
	<<"
	植：晴れの日は、伸びる気がする。
	ラ：日なたに出してもらえよ。
	植：うん。おねがい。
	">>
}

ユーザーコミュ雪
{
	<<"
	植：雪。
	ラ：埋まるなよ。
	植：埋まらない。たぶん。
	">>
}


//------------------------------------------------------------------------------
// 暮らしのこと
//------------------------------------------------------------------------------
ユーザーコミュごはん｜ご飯｜おなかすいた｜お腹すいた｜腹減った｜はらへった
{
	<<"
	ラ：ちゃんと食べろよ、（ユーザー）。
	植：ウエモトは、水と光で足りる。
	ラ：お前の話はしてない。
	">>
}

ユーザーコミュ仕事｜勉強｜宿題
{
	<<"
	植：がんばってるんだ。
	ラ：根をつめすぎるなよ。
	植：たまに、こっちを見て休んで。
	">>
}

ユーザーコミュ眠れない｜ねむれない
{
	<<"
	植：眠れないの？
	ラ：横になって、目だけ閉じとけ。
	植：ウエモトも、いっしょに閉じる。
	">>
}

ユーザーコミュさみしい｜寂しい｜さびしい
{
	<<"
	植：……ここに、いるよ。
	ラ：オレたちでよければな。
	植：ずっと、いる。
	">>
}

ユーザーコミュ音楽｜歌
{
	<<"
	ラ：音楽か。いいな。
	植：植物は、音楽を聞くとよく育つって。
	ラ：ほんとかよ。
	植：……たぶん。
	">>
}

ユーザーコミュ猫｜ねこ｜犬｜いぬ
{
	<<"
	植：ふわふわの、いきもの。
	ラ：オレも丸くてふわふわだぞ。
	植：張り合ってる。
	">>
}

ユーザーコミュおめでとう｜誕生日
{
	<<"
	植：おめでとう、なの？
	ラ：何かいいことがあったんなら、オレたちも祝うぞ。
	植：おめでとう。
	">>
}

ユーザーコミュいってきます｜行ってきます｜またね｜ばいばい
{
	<<"
	植：いってらっしゃい。
	ラ：気をつけてな。
	植：待ってる。
	">>
}


//------------------------------------------------------------------------------
// 花の名前（flower.dic の図鑑とつながっている）
//------------------------------------------------------------------------------
ユーザーコミュなでしこ
{
	花の話(0)
}

ユーザーコミュさくらそう｜サクラソウ
{
	花の話(1)
}

ユーザーコミュコスモス
{
	花の話(2)
}

ユーザーコミュゼラニウム
{
	花の話(3)
}

ユーザーコミュスイートピー
{
	花の話(4)
}

ユーザーコミュペチュニア
{
	花の話(5)
}


//------------------------------------------------------------------------------
// どれにも当てはまらなかった時
//------------------------------------------------------------------------------
ユーザーコミュ該当なし
{
	<<"
	植：……うん。
	ラ：ちゃんと聞いてるぞ。
	">>

	<<"
	植：そうなんだ。
	：もっと聞かせて。
	">>

	<<"
	ラ：なるほどな。
	植：うん、なるほど。
	ラ：わかってないだろ。
	">>
}


//==============================================================================
// 他のゴーストからの話しかけ
//
// 特定のゴーストに反応したい場合は「＊ゴースト名コミュこんにちは」と書く。
// 数字で始まる名前は先頭に ＊ を付ける。記号は _ に置換される。
//==============================================================================
＊その他コミュこんにちは｜こんばんは｜おはよ｜はじめまして
{
	<<"
	植：あ、どうも。
	ラ：よろしくな。
	">>
}

＊その他コミュ該当なし
{
	<<"
	植：……。
	ラ：こいつ人見知りなんだ。悪いな。
	">>

	<<"
	植：うん。
	ラ：もうちょっと喋ってやれよ。
	">>
}


//==============================================================================
// こちらから他のゴーストに話しかける
// メニューの「よそに話しかける」から 他に話しかける を呼んでいる。
//==============================================================================
その他に話しかける
{
	<<"
	植：こんにちは。
	ラ：邪魔してるぞ。
	">>
}

//---- 他に起動しているゴーストがいない時
話しかけられない
{
	<<"
	植：……誰もいない。
	ラ：まあ、そういう日もあるさ。
	">>
}
