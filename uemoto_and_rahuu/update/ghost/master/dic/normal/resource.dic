//******************************************************************************
// 植本とラフウ
// リソース辞書（右クリックメニューの文言・リンク）
//******************************************************************************

//==============================================================================
// リンクメニュー
//
// 書式：'表示名 | URL | バナー画像(省略可)'
//
// 【重要】関数名の末尾に必ず「: array」を付け、1行1リンクで並べること。
//         -- （出力確定子）で区切ると候補が連結されて1本の文字列になり、
//         2件目以降が表示されなくなる。
//
// 不要ならブロックごと消してよい。
//==============================================================================

//---- ポータル
ポータルサイト : array
{
	'配布サイト | https://cherry.narnaloader.ukagaka.net/ghost.php?ghost=uemoto_and_rahuu |'
	'伺か（UKADOC） | https://ssp.shillest.net/ukadoc/manual/ |'
	'YAYA | https://github.com/YAYA-shiori/yaya-shiori |'
	'シェル製作者のサイト | https://rocketsalad.studio.site |'
}

//---- 植本側のおすすめ（現作者のリンク集）
おすすめ0 : array
{
	'現作者のTwitter | https://x.com/ukagaka_irono |'
	'現作者のうかどん | https://ukadon.shillest.net/@ukagaka_irono |'
	'現作者のYouTube | https://www.youtube.com/@ukagaka_irono |'
	'現作者のななろだ | https://cherry.narnaloader.ukagaka.net/developer.php?developer=_ukagaka_irono |'
	'現作者のGitHub | https://github.com/ukagaka-irono |'
}

//---- ラフウ側のおすすめ（旧作者のリンク集）
おすすめ1 : array
{
	'旧作者のTwitter | https://x.com/yanashi_interf |'
	'旧作者のほしいものリスト | https://www.amazon.co.jp/hz/wishlist/ls/23JSIQUAUV6WL |'
	'旧作者のYouTube | https://www.youtube.com/@yamanashi_yukinterface |'
	'旧作者のGithub | https://github.com/miyagawa-yukinterface |'
}

//------------------------------------------------------------------------------
// リンクを選んだ時のトーク（任意）
//
// 関数名 = 「おすすめ0」「おすすめ1」「ポータルサイト」＋ 上で書いた表示名
//   例）'旧作者のTwitter | ...'（おすすめ1） → おすすめ1旧作者のTwitter
//
// 【注意】表示名を変えたら、この関数名も必ず一緒に変えること。
//         別の一覧へ移した時も、頭の「おすすめ0／おすすめ1／ポータルサイト」を変えること。
//         合っていないと黙って何も喋らなくなる（エラーにはならない）。
// 表示名に含まれる 半角空白 ! " # $ % & ( ) * + , - / : ; < = > ? @ [ ] ` { | } ~
// は _ に置換されたものが関数名になる。
//------------------------------------------------------------------------------

