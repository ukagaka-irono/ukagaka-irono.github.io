//==============================================================================
// ネットワーク更新
//
// 更新先は ghost/master/descript.txt の homeurl に書いてある。
//==============================================================================

OnUpdateBegin
{
	<<"
	植：更新、見てくる。
	ラ：新しいのが出てるかもな。
	">>
}

//---- reference[0] は「ダウンロードするファイル数 - 1」
OnUpdateReady
{
	<<"
	植：%(TOINT(reference[0]) + 1)個、落としてくるね。
	ラ：ちょっと待っててくれ。
	">>
}

OnUpdateComplete
{
	//---- 更新するものが無かった
	if reference[0] == 'none' {
		<<"
		植：新しいのは無かった。
		ラ：今のままで元気にやってるってことだ。
		">>
		return
	}

	<<"
	植：更新できた。
	ラ：なにか増えてるかもな。
	植：たぶん、ちょっとだけ。
	">>
}

OnUpdateFailure
{
	if reference[0] == 'timeout' {
		<<"
		植：時間切れだって。
		ラ：回線の機嫌が悪いんだろ。また今度な。
		">>
		return
	}

	if reference[0] == 'md5 miss' {
		<<"
		植：ファイルが壊れてるみたい。
		ラ：これは配布元の問題かもしれん。
		：気が向いたら作者に伝えてやってくれ。
		">>
		return
	}

	//---- それ以外。外から来た文字列なので必ずエスケープしてから出す
	_msg = さくらスクリプト無効化(reference[0])
	<<"
	植：更新できなかった。
	：「%(_msg)」だって。
	ラ：まあ、そういう日もある。
	">>
}


//==============================================================================
// 消滅（アンインストール）まわり
//==============================================================================
OnVanishSelecting
{
	<<"
	植：……お別れ？
	ラ：ちょっと待て、本気か。
	">>
}

OnVanishCancel
{
	<<"
	ラ：なんだ、脅かすなよ。
	植：よかった。
	">>
}

OnVanishSelected
{
	<<"
	植：わかった。
	：ここまでありがとう。
	ラ：達者でな、（ユーザー）。
	植：……またどこかで。
	＠スクリプト：\-
	">>
}
