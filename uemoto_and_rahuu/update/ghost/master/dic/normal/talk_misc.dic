//******************************************************************************
// 植本とラフウ
// 見切れ辞書
//
// キャラクターが画面の端からはみ出した／戻ってきた時の反応。
// あやりりすが OnOffScreen を受けて、スコープごとに
//   見切れ0 / 見切れ解除0 / 見切れ1 / 見切れ解除1
// を呼び分ける。
//
// 片方だけはみ出した場合はその子だけが呼ばれる。
//******************************************************************************

//==============================================================================
// 植本（\0）
//==============================================================================
見切れ0
{
	<<"
	植：……せまい。
	ラ：はみ出してるぞ。
	">>

	<<"
	植：葉っぱが引っかかる。
	ラ：戻してもらえって。
	">>
}

見切れ解除0
{
	<<"
	植：出られた。
	ラ：よかったな。
	">>

	<<"
	植：ありがとう。
	：やっぱり、広いほうがいい。
	">>
}


//==============================================================================
// ラフウ（\1）
//==============================================================================
見切れ1
{
	<<"
	ラ：おーい、埋まってるぞオレ。
	植：まるいから転がっていったんじゃない。
	ラ：転がってない。
	">>

	<<"
	ラ：ここ、狭いんだけど。
	植：がんばって。
	ラ：他人事だな。
	">>
}

見切れ解除1
{
	<<"
	ラ：助かった。
	植：おかえり。
	">>

	<<"
	ラ：ふう。やっぱり広いところがいいな。
	植：うん。
	">>
}
