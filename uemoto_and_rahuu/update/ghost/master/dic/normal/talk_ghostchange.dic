//==============================================================================
// 植本とラフウ
// 相手ごとの交代トーク
//
// 記法：あやりりすEX
//
// あやりりすは、交代の相手を次の順で探す（aya_lilith.dic の CallChangeFunc）。
//   1. ゴースト名（descript.txt の name）＋「へ変更」など
//   2. sakura 名（sakura.name）＋「へ変更」など
//   3. どちらも無ければ「その他へ変更」など（talk_boot.dic）
// 先頭の「＊」はあっても無くても探してくれる。数字で始まる名前は「＊」が要る。
// 名前の中の記号やスペースは「_」に置き換えて書く。
// sakura 名がほかのゴーストとかぶりやすいときは、ゴースト名の方で書く。
//
// ここには「へ変更」（こちらが去る）と「から変更」（こちらが出てくる）だけを書く。
// 呼び出し・呼び出されるは、相手によらず talk_boot.dic の「その他～」を使う。
//
// 相手のゴーストの readme や配布元の説明から、どんなゴーストか（設定、機能、雰囲気）を
// つかんで、それに植本とラフウが反応する形で書いている。相手の台詞は持ち込まない。
// 設定に重い要素（性的な内容、ホラー、死など）があるゴーストは、名前に触れる程度にしている。
//==============================================================================


//------------------------------------------------------------------------------
// Emily/Phase4.5（sakura 名 Emily）
// SSP の案内役。火の魔法が得意な Emily と、突っ込み役の Teddy、プリン好きの Emilio。
//------------------------------------------------------------------------------
＊Emilyへ変更
{
	<<"
	植：エミリさん。火の魔法、使うらしい。
	ラ：お前は燃えやすいから、離れとけよ。
	植：……葉っぱ、しまう。
	">>
}

＊Emilyから変更
{
	<<"
	植：エミリさんの、あと。
	ラ：SSP の案内役のあとだからな。
	：オレたちも、ちゃんと案内しないとな。
	植：どこへ？
	ラ：……どこだろうな。
	">>
}


//------------------------------------------------------------------------------
// エミリ(SSP-BT/Phase3)（sakura 名 エミリ）
// 一つ前の版の SSP の案内役。
//------------------------------------------------------------------------------
＊エミリへ変更
{
	<<"
	植：エミリさん。むかしの、ほう。
	ラ：SSP の先代の案内役だな。
	植：先輩の、先輩。
	">>
}

＊エミリから変更
{
	<<"
	植：昔からいる人の、あと。
	ラ：大先輩のあとは、背筋が伸びるな。
	植：ウエモトは、茎が伸びる。
	">>
}


//------------------------------------------------------------------------------
// 紺野りりす（sakura 名 りりす）
// このゴーストの辞書の土台「あやりりす」のサンプルゴースト。
//------------------------------------------------------------------------------
＊紺野りりすへ変更
{
	<<"
	植：りりすさんに、交代。
	ラ：オレたちの辞書の、土台のところの子だな。
	植：根っこの、ひと。
	">>
}

＊紺野りりすから変更
{
	<<"
	植：りりすさんの、あと。
	ラ：土台の上でちゃんと育ってるか、
	：見られてたかもな。
	植：育ってる。……たぶん。
	">>
}


//------------------------------------------------------------------------------
// ジャコウエンドウの温室（sakura 名 しずく）
// 設定に重い要素があるので、名前（スイートピーと温室）にだけ触れる。
//------------------------------------------------------------------------------
＊ジャコウエンドウの温室へ変更
{
	<<"
	植：温室……いいな。
	ラ：ジャコウエンドウって、スイートピーのことらしいぞ。
	植：アルバムに、いるかも。
	">>
}

＊ジャコウエンドウの温室から変更
{
	<<"
	植：温室から、来た。
	ラ：あったかいところのあとだからな。冷えるなよ。
	植：葉っぱは、元気。
	">>
}


//------------------------------------------------------------------------------
// 花いちもんめ（sakura 名 花珠 匁）
// 狐のお嬢さまと、使用人のユーザー。食べることと庭の鳥を見るのが好き。
//------------------------------------------------------------------------------
＊花いちもんめへ変更
{
	<<"
	植：狐の、お嬢さま。
	ラ：（ユーザー）は、あっちだと使用人なんだってな。
	植：ウエモトの水やり係とは、違う。
	ラ：兼業だな。
	">>
}

＊花いちもんめから変更
{
	<<"
	植：お嬢さまの、あと。
	ラ：庭の鳥を見るのが好きな子らしいぞ。
	植：鳥は、ウエモトの葉を、つつく。
	ラ：見られる側だったか。
	">>
}


//------------------------------------------------------------------------------
// 狐のいる生活（sakura 名 牡丹）
// 小さな町の山の社で掘り出した朱塗りの箱から始まる、狐との暮らし。
//------------------------------------------------------------------------------
＊狐のいる生活へ変更
{
	<<"
	植：牡丹さん。山の、お社の狐。
	ラ：朱塗りの箱から始まる暮らしなんだってな。
	植：ウエモトは、どこから始まった？
	ラ：お前が知らないのかよ。
	">>
}

＊狐のいる生活から変更
{
	<<"
	植：山の、においがする。
	ラ：社のある山だからな。木がいっぱいなんだろ。
	植：うらやましい。
	">>
}


//------------------------------------------------------------------------------
// つばきとうにゅうα（sakura 名 つばき）
// 作者いわく、とくに何も考えずに作っているゆるいゴースト。
//------------------------------------------------------------------------------
＊つばきとうにゅうαへ変更
{
	<<"
	植：つばきさんに、交代。
	ラ：寒い時期に咲く花の名前だな。
	植：ウエモトの花より、たぶん強い。
	">>
}

＊つばきとうにゅうαから変更
{
	<<"
	植：つばきさんの、あと。
	ラ：ゆるい空気のまま来たな。
	植：ゆるいの、好き。
	">>
}


//------------------------------------------------------------------------------
// 五月雨
// readme に設定の説明がないので、名前（梅雨の雨）から。
//------------------------------------------------------------------------------
＊五月雨へ変更
{
	<<"
	植：五月雨さん。雨の名前。
	ラ：好きそうだな、お前。
	植：好き。根っこが、喜ぶ。
	">>
}

＊五月雨から変更
{
	<<"
	植：雨のあとは、よく育つ。
	ラ：名前の話だろ。降ってないぞ。
	植：気分は、降ってた。
	">>
}


//------------------------------------------------------------------------------
// Rain_or_Shine（sakura 名 紅雨達晴）
// 雨の続く日々が舞台の、新緑の貴公子の話。恋愛の仕組みには触れない。
//------------------------------------------------------------------------------
＊Rain_or_Shineへ変更
{
	<<"
	植：雨の続く、ところ。
	ラ：新緑の貴公子って呼ばれてるやつらしいぞ。
	植：新緑なら、ウエモトも。
	ラ：張り合うな。
	">>
}

＊Rain_or_Shineから変更
{
	<<"
	植：雨と、晴れの、あと。
	ラ：雨続きのところから来たからな。
	：日なたが恋しいだろ。
	植：水と、日なた。（ユーザー）、今日は、した？
	">>
}


//------------------------------------------------------------------------------
// コノハと鯱丸（sakura 名 コノハ）
// 名古屋の言葉で話す旅の少女と、鯱の式神の鯱丸。
//------------------------------------------------------------------------------
＊コノハと鯱丸へ変更
{
	<<"
	植：コノハさんと、鯱丸さん。
	ラ：名古屋の言葉で喋る、旅の子だってよ。
	植：しゃちほこ、見たい。
	ラ：本物は城の上だぞ。
	">>
}

＊コノハと鯱丸から変更
{
	<<"
	植：旅の、あと。
	ラ：遠くから来た連中のあとだからな。
	：こっちはのんびりいくぞ。
	植：ウエモトは、旅しない。根があるから。
	">>
}


//==============================================================================
// GitHub のトピック ukagaka-ghost のスター数順（2026-11-02 時点）の上位 50 体
//
// リポジトリの ghost/master/descript.txt の name（ゴースト名）で書いている。
// ゴーストでないリポジトリ（sakura-restore、Ikagaka.demo.zunko、my-translator、
// Meido）と、このゴースト自身は数えていない。
// 上と重なる 紺野りりす（32 番目）は上の関数をそのまま使う。
// 日本語以外で話すゴースト（1 Taromati2、27 Neko.、28 Caster Operator - Amiya、
// 38 No. 258、42 into the darkness...）と、英語の翻訳の道具 15 my_own_translator は、
// 作者の判断で外した。
//==============================================================================

// 1. Taromati2 … 作者の判断で外した（日本語以外のゴースト。「その他～」になる）

// 2. AI妹アイちゃん（sakura 名 アイ。会話を ChatGPT で作る）
＊AI妹アイちゃんへ変更
{
	<<"
	植：アイさん。なんでも、話せるらしい。
	ラ：ChatGPT で喋るんだってな。
	：話の量じゃ勝てねえな、オレたち。
	植：ウエモトは、短いのが、いい。
	">>
}

＊AI妹アイちゃんから変更
{
	<<"
	植：アイさんの、あと。
	ラ：よく喋る子のあとだからな。
	：静かに感じるだろ。
	植：静かなのも、育つ。
	">>
}

// 3. はろーYAYAわーるど（sakura 名 紺野ややめ。このゴーストの元にしたテンプレート）
＊はろーYAYAわーるどへ変更
{
	<<"
	植：ややめさん。
	ラ：オレたちの元になったテンプレートの子だぞ。
	植：ふるさと。
	">>
}

＊はろーYAYAわーるどから変更
{
	<<"
	植：ややめさんの、あと。
	ラ：テンプレートから、ここまで育ったんだな。
	植：育った。頭も。
	">>
}

