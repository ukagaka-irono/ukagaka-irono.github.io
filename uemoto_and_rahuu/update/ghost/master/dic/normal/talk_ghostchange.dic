// 18. Ghost in a Nutshell（会話をすべて LLM で作るゴースト）
// ゴースト名を関数名にすると YAYA の演算子 _in_ を含んでしまい書けないので、
// sakura 名 Ghost で受けて、ゴースト名（reference[2]）が違えば何も返さない
// （何も返さなければ「その他～」になる）。
＊Ghostへ変更
{
	if reference[2] != 'Ghost in a Nutshell' {
		return
	}
	<<"
	植：Ghost in a Nutshell さん。
	ラ：全部その場で考えて喋るゴーストらしいぞ。
	植：ウエモトも、その場で考えてる。
	ラ：嘘つけ。
	">>
}

＊Ghostから変更
{
	if reference[2] != 'Ghost in a Nutshell' {
		return
	}
	<<"
	植：ナッツの、あと。
	ラ：殻の中から来たみたいな名前だったな。
	植：ウエモトも、たねから。
	">>
}

