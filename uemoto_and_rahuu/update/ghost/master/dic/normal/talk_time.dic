//******************************************************************************
// 植本とラフウ
// 時報・日付変更辞書
//
// ■時報（毎時0分に呼ばれる）
//   探索順： 時報M月D日H時 → 時報H時 → 時報
//   下の「時報」が全時刻共通のフォールバック。
//   特定の時刻だけ変えたければ「時報7時」のように足せばそちらが優先される。
//
// ■日付変更（日をまたいで最初の0分に1回だけ）
//   探索順： 日付変更M月D日 → 日付変更
//   日付変更が何か喋った場合、その分の時報は出ない（二重に喋らない）。
//
// ■注意
//   同じ分に植物が育った場合は、成長トークのほうが優先される。
//   （あやりりす側が 累積起動時間変化 を先に処理して return するため）
//******************************************************************************

//==============================================================================
// 全時刻共通の時報
//==============================================================================
時報
{
	<<"
	植：%(hour)時。
	ラ：はやいもんだな。
	">>

	<<"
	ラ：%(hour)時だぞ。
	植：うん、知ってる。
	ラ：知ってても言うんだよ。
	">>

	<<"
	植：……%(hour)時。
	：時間って、勝手に進む。
	ラ：そりゃそうだ。
	">>
}


//==============================================================================
// 時刻別の時報
// 書いた時刻だけ上の共通版より優先される。
//==============================================================================

時報3時
{
	<<"
	植：%(hour)時。
	ラ：まだ起きてるのか、（ユーザー）。
	植：無理はしないで。
	">>
}

時報6時
{
	<<"
	植：朝。
	ラ：６時だ。
	植：この時間の空気、いちばん好き。
	">>
}

時報12時
{
	<<"
	ラ：昼だ。めし食えよ。
	植：ウエモトは光でいい。
	ラ：お前はな。
	">>
}

時報15時
{
	<<"
	植：３時。
	ラ：おやつの時間だな。
	植：ウエモトのぶんは？
	ラ：ないよ。
	">>
}

時報18時
{
	<<"
	植：暗くなってきた。
	ラ：６時だな。
	植：そろそろ、葉っぱを閉じたい気分。
	">>
}

時報22時
{
	<<"
	ラ：１０時か。
	植：（ユーザー）、今日はもう休んだら。
	ラ：心配してるぞ、こいつ。
	植：してない。
	">>
}


//==============================================================================
// 日付変更
//==============================================================================
日付変更
{
	<<"
	植：日付、変わった。
	ラ：新しい日だな。
	植：……水、またもらえる。
	ラ：そっちが本題か。
	">>

	<<"
	ラ：日付が変わったぞ。
	植：うん。
	：今日も、よろしく。
	">>
}

//------------------------------------------------------------------------------
// 特定の日付
// 「日付変更1月1日」のように書くと、その日だけ差し替わる。
//------------------------------------------------------------------------------
日付変更1月1日
{
	<<"
	植：あけましておめでとう。
	ラ：今年もよろしくな、（ユーザー）。
	植：今年も、ゆっくり育つね。
	ラ：急がなくていいさ。
	">>
}
