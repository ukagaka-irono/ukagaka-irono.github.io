//******************************************************************************
// 植本とラフウ
// 緊急時辞書
//
// 通常の辞書に構文エラーがあって読み込めなかった時だけ、これが使われる。
//
// ！！！！！！！！！！！！！！！！！！！！！！！！！！！！！！！！！！！！！
// ！！！ ここには絶対にエラーの原因になる書き方をしないこと          ！！！
// ！！！ あやりりすは読み込まれないので、素のYAYAの書き方をすること  ！！！
// ！！！！！！！！！！！！！！！！！！！！！！！！！！！！！！！！！！！！！
//******************************************************************************

OnBoot
{
	'\0\s[0]\1\s[10]\0辞書が読み込めませんでした。\w9\1エラーログを見てくれ。\e'
}

OnFirstBoot
{
	OnBoot
}

OnSecondChange
{
	//---- 緊急時は何もしない（ランダムトークを止める）
}

OnClose
{
	'\0\s[0]\1\s[-1]\0直しておきます。\w9\-\e'
}
